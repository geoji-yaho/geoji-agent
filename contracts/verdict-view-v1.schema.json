{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "verdict-view-v1.schema.json",
  "title": "VerdictView",
  "$defs": {
    "Intensity": {
      "enum": [
        "mild",
        "spicy",
        "hell"
      ],
      "type": "string"
    },
    "JuryStatus": {
      "description": "`verdict-view-v1` 의 `jury_status`. 각하까지 5종.",
      "enum": [
        "guilty",
        "notGuilty",
        "agree",
        "disagree",
        "dismissed"
      ],
      "type": "string"
    },
    "MemeTag": {
      "enum": [
        "GUILTY_HEAVY",
        "GUILTY_LIGHT",
        "NOT_GUILTY",
        "APPROVED",
        "REJECTED"
      ],
      "type": "string"
    },
    "MemeView": {
      "additionalProperties": false,
      "properties": {
        "tag": {
          "$ref": "#/$defs/MemeTag"
        },
        "imageId": {
          "type": "string"
        },
        "imageUrl": {
          "type": "string"
        }
      },
      "required": [
        "tag",
        "imageId",
        "imageUrl"
      ],
      "type": "object"
    },
    "SentenceCode": {
      "enum": [
        "probation",
        "oneDay",
        "life"
      ],
      "type": "string"
    },
    "VerdictTextView": {
      "additionalProperties": false,
      "properties": {
        "intensity": {
          "$ref": "#/$defs/Intensity"
        },
        "headline": {
          "maxLength": 30,
          "type": "string"
        },
        "statement": {
          "items": {
            "maxLength": 300,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 4,
          "minItems": 1,
          "type": "array"
        },
        "sentence": {
          "anyOf": [
            {
              "$ref": "#/$defs/SentenceCode"
            },
            {
              "type": "null"
            }
          ]
        },
        "sentenceLabel": {
          "anyOf": [
            {
              "maxLength": 30,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "sentencingReason": {
          "anyOf": [
            {
              "maxLength": 100,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "source": {
          "enum": [
            "AI",
            "TEMPLATE"
          ],
          "type": "string"
        },
        "meme": {
          "anyOf": [
            {
              "$ref": "#/$defs/MemeView"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "intensity",
        "headline",
        "statement",
        "sentence",
        "sentenceLabel",
        "sentencingReason",
        "source",
        "meme"
      ],
      "type": "object"
    },
    "VerdictView": {
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": 1,
          "type": "integer"
        },
        "postId": {
          "type": "string"
        },
        "juryStatus": {
          "anyOf": [
            {
              "$ref": "#/$defs/JuryStatus"
            },
            {
              "type": "null"
            }
          ]
        },
        "sentenceStatus": {
          "enum": [
            "PENDING",
            "FINAL"
          ],
          "type": "string"
        },
        "textStatus": {
          "enum": [
            "PENDING",
            "GENERATING",
            "TEMPLATE_READY",
            "AI_READY"
          ],
          "type": "string"
        },
        "textVersion": {
          "minimum": 0,
          "type": "integer"
        },
        "view": {
          "anyOf": [
            {
              "$ref": "#/$defs/VerdictTextView"
            },
            {
              "type": "null"
            }
          ]
        },
        "pollAfterMs": {
          "maximum": 60000,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "schemaVersion",
        "postId",
        "juryStatus",
        "sentenceStatus",
        "textStatus",
        "textVersion",
        "view",
        "pollAfterMs"
      ],
      "type": "object"
    }
  },
  "$ref": "#/$defs/VerdictView"
}
