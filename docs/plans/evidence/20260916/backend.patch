new file mode 100644
index 0000000000000000000000000000000000000000..eecaf11eb2b950830d053ccfbefc4bf6f0ae373f
--- /dev/null
+++ b/src/test/java/com/ttegeoji/backend/api/MediaRecoveryTest.java
@@ -0,0 +1,136 @@
+package com.ttegeoji.backend.api;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.assertj.core.api.Assertions.assertThatThrownBy;
+import static org.mockito.ArgumentMatchers.any;
+import static org.mockito.ArgumentMatchers.startsWith;
+import static org.mockito.Mockito.doCallRealMethod;
+import static org.mockito.Mockito.doThrow;
+
+import com.ttegeoji.backend.media.CardService;
+import com.ttegeoji.backend.media.ImageService;
+import com.ttegeoji.backend.media.MediaStorage;
+import com.ttegeoji.backend.support.PostgresContainerSupport;
+
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.boot.test.context.SpringBootTest;
+import org.springframework.dao.DataAccessResourceFailureException;
+import org.springframework.jdbc.core.JdbcTemplate;
+import org.springframework.mock.web.MockMultipartFile;
+import org.springframework.test.context.bean.override.mockito.MockitoSpyBean;
+
+import java.awt.image.BufferedImage;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.nio.file.attribute.FileTime;
+import java.util.UUID;
+
+/** 프로세스 중단/DB 응답 유실의 DB 상태를 재현한다. 실제 서버 재시작은 별도 E2E 러너가 검증한다. */
+@SpringBootTest(
+        properties = {
+            "geoji.media.root=/private/tmp/geoji-media-recovery-test",
+            "geoji.media.font-path=/System/Library/Fonts/AppleSDGothicNeo.ttc",
+            "geoji.media.enabled=false"
+        })
+class MediaRecoveryTest extends PostgresContainerSupport {
+    @Autowired ImageService images;
+    @Autowired CardService cards;
+    @Autowired MediaStorage storage;
+    @MockitoSpyBean JdbcTemplate jdbc;
+    private PostVerdictControllerTest.Fixtures f;
+    private UUID owner;
+
+    @BeforeEach
+    void seed() {
+        f = new PostVerdictControllerTest.Fixtures(jdbc);
+        owner = f.profile();
+    }
+
+    private MockMultipartFile file() {
+        var image = new BufferedImage(20, 20, BufferedImage.TYPE_INT_RGB);
+        image.setRGB(1, 1, UUID.randomUUID().hashCode());
+        return new MockMultipartFile("file", "valid.png", "image/png", MediaStorage.png(image));
+    }
+
+    @Test
+    void transformSavedBeforeDatabaseFailureIsReusedOnRetry() throws Exception {
+        var image = images.upload(owner, file());
+        images.transform(owner, image.id(), "GRAYSCALE");
+        doThrow(new DataAccessResourceFailureException("simulated completion failure"))
+                .when(jdbc)
+                .update(
+                        startsWith("UPDATE media_transforms SET status='READY'"),
+                        any(Object[].class));
+        try {
+            images.runTransform();
+        } finally {
+            doCallRealMethod()
+                    .when(jdbc)
+                    .update(
+                            startsWith("UPDATE media_transforms SET status='READY'"),
+                            any(Object[].class));
+        }
+        assertThat(images.transformation(owner, image.id()).status()).isEqualTo("FAILED");
+        String recipe =
+                MediaStorage.hash(
+                        (image.sha256() + ":" + ImageService.TRANSFORM_VERSION)
+                                .getBytes(StandardCharsets.UTF_8));
+        Path derived = Path.of("/private/tmp/geoji-media-recovery-test/derived", recipe + ".png");
+        assertThat(Files.exists(derived)).isTrue();
+        FileTime savedTime = FileTime.fromMillis(1234);
+        Files.setLastModifiedTime(derived, savedTime);
+        images.transform(owner, image.id(), "GRAYSCALE");
+        images.runTransform();
+        assertThat(images.transformation(owner, image.id()).status()).isEqualTo("READY");
+        assertThat(Files.getLastModifiedTime(derived)).isEqualTo(savedTime);
+    }
+
+    @Test
+    void cardExpiredRenderingLeaseRecoversSameStoredPng() throws Exception {
+        UUID post = f.post(owner, "spent", "now()+interval '1 hour'");
+        f.verdict(post, "guilty", "FINAL", "oneDay", "비공개", "TEMPLATE_READY", 1, "mild");
+        var job = cards.request(post, owner, false);
+        for (int i = 0; i < 10 && !cards.status(post, owner).status().equals("READY"); i++)
+            cards.runCard();
+        String hash = cards.status(post, owner).pngSha256();
+        assertThat(hash).hasSize(64);
+        Path derived =
+                Path.of("/private/tmp/geoji-media-recovery-test/derived", job.inputHash() + ".png");
+        FileTime savedTime = FileTime.fromMillis(1234);
+        Files.setLastModifiedTime(derived, savedTime);
+        jdbc.update(
+                "UPDATE share_card_jobs SET status='RENDERING',lease_until=now()-interval '1"
+                    + " second',png_sha256=NULL WHERE id=?",
+                job.id());
+        cards.runCard();
+        assertThat(cards.status(post, owner).status()).isEqualTo("READY");
+        assertThat(cards.content(post, owner).hash()).isEqualTo(hash);
+        assertThat(Files.getLastModifiedTime(derived)).isEqualTo(savedTime);
+    }
+
+    @Test
+    void mimeDimensionsAndTraversalAreValidatedBeforeWriting() throws Exception {
+        var valid = file();
+        var wrongMime = new MockMultipartFile("file", "ok.jpg", "image/jpeg", valid.getBytes());
+        assertThatThrownBy(() -> images.upload(owner, wrongMime))
+                .isInstanceOf(IllegalArgumentException.class);
+        var oversized =
+                new MockMultipartFile(
+                        "file", "big.png", "image/png", new byte[MediaStorage.MAX_BYTES + 1]);
+        assertThatThrownBy(() -> images.upload(owner, oversized))
+                .isInstanceOf(IllegalArgumentException.class);
+        var wide =
+                new MockMultipartFile(
+                        "file",
+                        "wide.png",
+                        "image/png",
+                        MediaStorage.png(new BufferedImage(4097, 1, BufferedImage.TYPE_INT_RGB)));
+        assertThatThrownBy(() -> images.upload(owner, wide))
+                .isInstanceOf(IllegalArgumentException.class);
+        assertThatThrownBy(() -> storage.get("../../secret"))
+                .isInstanceOf(IllegalArgumentException.class);
+    }
+}
