+        return hash;
+    }
+
+    public byte[] get(String hash) {
+        try {
+            byte[] bytes = Files.readAllBytes(blob(hash));
+            if (!hash(bytes).equals(hash)) throw new IllegalStateException("저장 이미지 해시가 일치하지 않습니다.");
+            return bytes;
+        } catch (IOException e) {
+            throw new IllegalStateException("저장 이미지가 없습니다.", e);
+        }
+    }
+
+    public byte[] derived(String recipe) {
+        Path path = recipePath(recipe);
+        try {
+            return Files.exists(path) ? Files.readAllBytes(path) : null;
+        } catch (IOException e) {
+            throw new IllegalStateException("변환 결과를 읽을 수 없습니다.", e);
+        }
+    }
+
+    public void saveDerived(String recipe, byte[] bytes) {
+        writeOnce(recipePath(recipe), bytes);
+    }
+
+    private Path recipePath(String recipe) {
+        requireHash(recipe);
+        return root.resolve("derived").resolve(recipe + ".png");
+    }
+
+    private Path blob(String hash) {
+        requireHash(hash);
+        return root.resolve("blobs").resolve(hash.substring(0, 2)).resolve(hash);
