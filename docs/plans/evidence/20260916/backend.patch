+package com.ttegeoji.backend.ai;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+import com.sun.net.httpserver.HttpServer;
+import com.ttegeoji.backend.config.AiApiClientConfig;
+import com.ttegeoji.backend.config.GeojiProperties;
+import com.ttegeoji.backend.domain.enums.PostType;
+
+import org.junit.jupiter.api.Test;
+
+import java.net.InetSocketAddress;
+import java.nio.charset.StandardCharsets;
+import java.util.ArrayList;
+import java.util.UUID;
+
+class AiHttpVersionTest {
+    @Test
+    void allAiClientsSendHttp11WithoutH2cUpgrade() throws Exception {
+        var upgrades = new ArrayList<String>();
+        var bodies = new ArrayList<String>();
+        var server = HttpServer.create(new InetSocketAddress("127.0.0.1", 0), 0);
+        server.createContext(
+                "/",
+                exchange -> {
+                    upgrades.add(exchange.getRequestHeaders().getFirst("Upgrade"));
+                    bodies.add(
+                            new String(
+                                    exchange.getRequestBody().readAllBytes(),
+                                    StandardCharsets.UTF_8));
+                    var bytes = "{}".getBytes(StandardCharsets.UTF_8);
+                    exchange.getResponseHeaders().add("Content-Type", "application/json");
+                    exchange.sendResponseHeaders(200, bytes.length);
+                    exchange.getResponseBody().write(bytes);
+                    exchange.close();
+                });
+        server.start();
+        try {
+            var config =
+                    new GeojiProperties(
+                            new GeojiProperties.Internal("test"),
+                            new GeojiProperties.Ai(
+                                    "http://127.0.0.1:" + server.getAddress().getPort()),
+                            "guardrail-v2");
+            var client = new AiApiClientConfig().aiApiRestClient(config);
+            client.get().uri("/base").retrieve().toBodilessEntity();
+            new IntakeClient(client, config)
+                    .call(
+                            new IntakeClient.IntakeRequest(
+                                    UUID.randomUUID().toString(),
+                                    "hash",
+                                    IntakeClient.Mode.INITIAL,
+                                    PostType.spent,
+                                    1000,
+                                    "식비",
+                                    "밥",
+                                    null));
+            new AiTraceClient(client).fetch(UUID.randomUUID());
+            assertThat(upgrades).hasSize(3).containsOnlyNulls();
+            assertThat(bodies.get(1)).contains("\"item\":\"밥\"", "\"amount_krw\":1000");
+        } finally {
+            server.stop(0);
+        }
+    }
+}
