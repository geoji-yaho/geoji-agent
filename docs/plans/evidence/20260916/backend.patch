new file mode 100644
index 0000000000000000000000000000000000000000..88c8e925e26a6f4387a39de6ba5f53adefb14478
--- /dev/null
+++ b/src/main/java/com/ttegeoji/backend/verdictview/PostDetailQueries.java
@@ -0,0 +1,84 @@
+package com.ttegeoji.backend.verdictview;
+
+import lombok.RequiredArgsConstructor;
+import org.springframework.jdbc.core.JdbcTemplate;
+import org.springframework.stereotype.Component;
+
+import java.sql.ResultSet;
+import java.sql.SQLException;
+import java.time.OffsetDateTime;
+import java.util.Arrays;
+import java.util.List;
+import java.util.Optional;
+import java.util.UUID;
+
+/** 사건 입력과 요청자 자신의 투표만 조회한다. 마감 판단은 투표 서비스와 같은 DB now(). */
+@Component
+@RequiredArgsConstructor
+public class PostDetailQueries {
+    private final JdbcTemplate jdbc;
+
+    public record Detail(UUID id, UUID authorId, String postType, int amountKrw, String category,
+                         String item, String reason, OffsetDateTime voteDeadlineAt,
+                         boolean deadlinePassed, String myVote, String juryStatus,
+                         String textStatus, List<UUID> roomIds) {
+    }
+
+    private static final String SELECT_DETAIL = """
+            SELECT p.id, p.author_id, p.post_type::text AS post_type, p.amount_krw,
+                   p.category, p.item, p.reason, p.vote_deadline_at,
+                   p.vote_deadline_at <= now() AS deadline_passed,
+                   (SELECT v.verdict::text FROM votes v
+                     WHERE v.post_id=p.id AND v.voter_id=?) AS my_vote,
+                   verdict.jury_result::text AS jury_status,
+                   COALESCE(verdict.text_status, 'PENDING') AS text_status,
+                   ARRAY(SELECT pr.room_id FROM post_rooms pr JOIN rooms r ON r.id=pr.room_id
+                          WHERE pr.post_id=p.id AND pr.revoked_at IS NULL AND r.deleted_at IS NULL
+                            AND (p.author_id=? OR EXISTS (SELECT 1 FROM room_members rm
+                                                         WHERE rm.room_id=pr.room_id AND rm.user_id=?))
+                          ORDER BY pr.room_id) AS room_ids
+              FROM posts p LEFT JOIN verdicts verdict ON verdict.post_id=p.id
+            """;
+
+    private static Detail map(ResultSet rs, int index) throws SQLException {
+        Object[] roomIds = (Object[]) rs.getArray("room_ids").getArray();
+        return new Detail(rs.getObject("id", UUID.class), rs.getObject("author_id", UUID.class),
+                rs.getString("post_type"), rs.getInt("amount_krw"), rs.getString("category"),
+                rs.getString("item"), rs.getString("reason"),
+                rs.getObject("vote_deadline_at", OffsetDateTime.class),
+                rs.getBoolean("deadline_passed"), rs.getString("my_vote"),
+                rs.getString("jury_status"), rs.getString("text_status"),
+                Arrays.stream(roomIds).map(id -> UUID.fromString(id.toString())).toList());
+    }
+
+    public Optional<Detail> findVisible(UUID postId, UUID userId) {
+        return jdbc.query(SELECT_DETAIL + """
+                         WHERE p.id=? AND p.deleted_at IS NULL
+                           AND (p.author_id=? OR EXISTS (
+                               SELECT 1 FROM post_rooms pr JOIN room_members rm ON rm.room_id=pr.room_id
+                               JOIN rooms r ON r.id=pr.room_id
+                                WHERE pr.post_id=p.id AND pr.revoked_at IS NULL AND rm.user_id=?
+                                  AND r.deleted_at IS NULL))
+                        """,
+                PostDetailQueries::map, userId, userId, userId, postId, userId, userId).stream().findFirst();
+    }
+
+    public boolean canViewRoom(UUID roomId, UUID userId) {
+        return Boolean.TRUE.equals(jdbc.queryForObject("""
+                SELECT EXISTS(SELECT 1 FROM rooms r JOIN room_members rm ON rm.room_id=r.id
+                               WHERE r.id=? AND r.deleted_at IS NULL AND rm.user_id=?)
+                """, Boolean.class, roomId, userId));
+    }
+
+    public List<Detail> recentInRoom(UUID roomId, UUID userId, int limit) {
+        return jdbc.query(SELECT_DETAIL + """
+                         WHERE p.deleted_at IS NULL AND EXISTS (
+                             SELECT 1 FROM post_rooms pr JOIN rooms r ON r.id=pr.room_id
+                             JOIN room_members rm ON rm.room_id=r.id
+                             WHERE pr.post_id=p.id AND pr.room_id=? AND pr.revoked_at IS NULL
+                               AND r.deleted_at IS NULL AND rm.user_id=?)
+                         ORDER BY p.created_at DESC, p.id DESC LIMIT ?
+                        """,
+                PostDetailQueries::map, userId, userId, userId, roomId, userId, limit);
+    }
+}
