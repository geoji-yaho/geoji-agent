@@ -0,0 +1,51 @@
+package com.ttegeoji.backend.verdictview;
+
+import com.ttegeoji.backend.verdictview.dto.PostDetailResponse;
+import lombok.RequiredArgsConstructor;
+import org.springframework.http.HttpStatus;
+import org.springframework.stereotype.Service;
+import org.springframework.transaction.annotation.Transactional;
+
+import java.util.List;
+import java.util.UUID;
+
+/** 판결 조회 권한을 재사용하고 실제 투표 서비스의 마감·중복 조건을 표시한다. */
+@Service
+@RequiredArgsConstructor
+public class PostDetailAssembler {
+    private final VerdictViewQueries queries;
+    private final VerdictViewAssembler verdictViews;
+    private final PostDetailQueries details;
+
+    @Transactional(readOnly = true)
+    public PostDetailResponse assemble(UUID postId, UUID userId) {
+        var post = queries.findPost(postId).filter(p -> !p.deleted())
+                .orElseThrow(PublicApiRejection::notFound);
+        if (!verdictViews.canView(post, userId, null)) {
+            throw PublicApiRejection.notFound();
+        }
+        var detail = details.findVisible(postId, userId).orElseThrow(PublicApiRejection::notFound);
+        return response(detail, userId);
+    }
+
+    @Transactional(readOnly = true)
+    public List<PostDetailResponse> list(UUID roomId, UUID userId, int limit) {
+        if (!details.canViewRoom(roomId, userId)) {
+            throw PublicApiRejection.notFound();
+        }
+        if (limit < 1 || limit > 100) {
+            throw new PublicApiRejection(HttpStatus.BAD_REQUEST, "조회 개수는 1~100이어야 합니다.");
+        }
+        return details.recentInRoom(roomId, userId, limit).stream()
+                .map(detail -> response(detail, userId)).toList();
+    }
+
+    private PostDetailResponse response(PostDetailQueries.Detail detail, UUID userId) {
+        boolean author = detail.authorId().equals(userId);
+        boolean canVote = !author && !detail.roomIds().isEmpty() && !detail.deadlinePassed()
+                && detail.myVote() == null && detail.juryStatus() == null;
+        return new PostDetailResponse(detail.id(), detail.authorId(), detail.postType(), detail.amountKrw(),
+                detail.category(), detail.item(), detail.reason(), detail.roomIds(), detail.voteDeadlineAt(),
+                detail.myVote(), canVote, detail.juryStatus(), detail.textStatus());
+    }
+}
