+    void roomFeedIncludesVerdictStatusAndLimit() throws Exception {
+        UUID newer = f.post(author, "considering", "now()+interval '1 hour'");
+        f.share(newer, room);
+        jdbc.update("UPDATE posts SET created_at=now()+interval '1 second' WHERE id=?", newer);
+        f.verdict(newer, "agree", "FINAL", null, null, "AI_READY", 1, "mild");
+        mockMvc.perform(get("/api/rooms/" + room + "/posts?limit=1").with(as(voter)))
+                .andExpect(status().isOk())
+                .andExpect(jsonPath("$.length()").value(1))
+                .andExpect(jsonPath("$[0].id").value(newer.toString()))
+                .andExpect(jsonPath("$[0].juryStatus").value("agree"))
+                .andExpect(jsonPath("$[0].textStatus").value("AI_READY"))
+                .andExpect(jsonPath("$[0].canVote").value(false));
+        mockMvc.perform(get("/api/rooms/" + room + "/posts?limit=0").with(as(voter)))
+                .andExpect(status().isBadRequest());
+        mockMvc.perform(get("/api/rooms/" + room + "/posts?limit=101").with(as(voter)))
+                .andExpect(status().isBadRequest());
+    }
+
+    @Test
+    @DisplayName("10 §8 방 피드는 삭제·철회 게시물을 제외하고 비회원·삭제방은 404")
+    void roomFeedPrivacy() throws Exception {
+        UUID revoked = f.post(author, "spent", "now()+interval '1 hour'");
+        UUID deleted = f.post(author, "spent", "now()+interval '1 hour'");
+        f.share(revoked, room);
+        f.share(deleted, room);
+        f.revoke(revoked, room);
+        jdbc.update("UPDATE posts SET deleted_at=now() WHERE id=?", deleted);
+        mockMvc.perform(get("/api/rooms/" + room + "/posts").with(as(voter)))
+                .andExpect(status().isOk())
+                .andExpect(jsonPath("$.length()").value(1))
+                .andExpect(jsonPath("$[0].id").value(postId.toString()))
+                .andExpect(jsonPath("$[0].juryStatus").value((Object) null))
+                .andExpect(jsonPath("$[0].textStatus").value("PENDING"));
+        mockMvc.perform(get("/api/rooms/" + room + "/posts").with(as(f.profile())))
+                .andExpect(status().isNotFound());
+        jdbc.update("UPDATE rooms SET deleted_at=now() WHERE id=?", room);
+        mockMvc.perform(get("/api/rooms/" + room + "/posts").with(as(author)))
+                .andExpect(status().isNotFound());
+        mockMvc.perform(get("/api/posts/" + postId).with(as(voter)))
+                .andExpect(status().isNotFound());
+        mockMvc.perform(get("/api/posts/" + postId).with(as(author)))
+                .andExpect(status().isOk()).andExpect(jsonPath("$.roomIds").isEmpty());
+        mockMvc.perform(get("/api/rooms/" + room + "/posts"))
+                .andExpect(status().isUnauthorized());
+    }
+}
diff --git a/src/test/java/com/ttegeoji/backend/media/CardRendererTest.java b/src/test/java/com/ttegeoji/backend/media/CardRendererTest.java
new file mode 100644
index 0000000000000000000000000000000000000000..caaa3c695e0a7efc0952978b4736610231198908
--- /dev/null
+++ b/src/test/java/com/ttegeoji/backend/media/CardRendererTest.java
@@ -0,0 +1,148 @@
+package com.ttegeoji.backend.media;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+import com.ttegeoji.backend.verdictview.dto.MemeView;
+import com.ttegeoji.backend.verdictview.dto.ShareCardResponse;
+
+import org.junit.jupiter.api.Test;
+
+import java.awt.image.BufferedImage;
+import java.io.ByteArrayInputStream;
+import java.util.List;
+
+import javax.imageio.ImageIO;
+
+class CardRendererTest {
+    @Test
+    void resultIsVisibleInHeaderEvenWhenMemeIsPresent() throws Exception {
+        var props =
+                new MediaProperties(
+                        "/private/tmp/geoji-card-renderer-test",
+                        "/System/Library/Fonts/AppleSDGothicNeo.ttc",
+                        "",
+                        "");
+        var renderer = new CardRenderer(props);
+        byte[] meme = MediaStorage.png(new BufferedImage(30, 30, BufferedImage.TYPE_INT_RGB));
+        var guilty = ImageIO.read(new ByteArrayInputStream(renderer.render(card("guilty"), meme)));
+        var innocent =
+                ImageIO.read(new ByteArrayInputStream(renderer.render(card("notGuilty"), meme)));
+        int different = 0;
+        for (int y = 0; y < 115; y++) {
+            for (int x = 0; x < 1080; x++) {
+                if (guilty.getRGB(x, y) != innocent.getRGB(x, y)) different++;
+            }
+        }
+        assertThat(different).isGreaterThan(100);
+    }
+
+    @Test
+    void fullThreeHundredKoreanCharactersRemainVisibleAboveTwoLineSentenceAndFooter()
+            throws Exception {
+        var renderer =
+                new CardRenderer(
+                        new MediaProperties(
+                                "/private/tmp/geoji-card-renderer-test",
+                                "/System/Library/Fonts/AppleSDGothicNeo.ttc",
+                                "",
+                                ""));
+        byte[] meme = MediaStorage.png(new BufferedImage(30, 30, BufferedImage.TYPE_INT_RGB));
+        String first = "가".repeat(295) + "끝까지표시";
+        String second = "가".repeat(295) + "다른마침말";
+        String sentence = "형량".repeat(25);
+        var left =
+                ImageIO.read(
+                        new ByteArrayInputStream(renderer.render(longCard(first, sentence), meme)));
+        var right =
+                ImageIO.read(
+                        new ByteArrayInputStream(
+                                renderer.render(longCard(second, sentence), meme)));
+        int different = 0;
+        for (int y = 940; y < 1270; y++) {
+            for (int x = 0; x < 1080; x++) {
+                if (left.getRGB(x, y) != right.getRGB(x, y)) different++;
+            }
+        }
+        assertThat(first.codePointCount(0, first.length())).isEqualTo(300);
+        assertThat(different).as("300자 본문의 마지막 글자도 본문 영역에 표시된다").isGreaterThan(100);
+        int outside = 0;
+        for (int y = 1270; y < 1440; y++) {
+            for (int x = 0; x < 1080; x++) {
+                if (left.getRGB(x, y) != right.getRGB(x, y)) outside++;
+            }
+        }
+        assertThat(outside).as("본문이 형량/하단 문구 영역으로 넘치지 않는다").isZero();
+    }
+
+    @Test
+    void unnecessaryWhitespaceDoesNotWasteBodyLines() throws Exception {
+        var renderer =
+                new CardRenderer(
+                        new MediaProperties(
+                                "/private/tmp/geoji-card-renderer-test",
+                                "/System/Library/Fonts/AppleSDGothicNeo.ttc",
+                                "",
+                                ""));
+        byte[] meme = MediaStorage.png(new BufferedImage(30, 30, BufferedImage.TYPE_INT_RGB));
+        byte[] normalized = renderer.render(longCard("공개 문구는 끝까지 확인합니다", "형량"), meme);
+        byte[] separated = renderer.render(longCard("공개\n\n문구는\t끝까지 확인합니다", "형량"), meme);
+        assertThat(separated).isEqualTo(normalized);
+    }
+
+    @Test
+    void wrappingKeepsGraphemeClustersAndEveryCharacter() {
+        var canvas = new BufferedImage(200, 200, BufferedImage.TYPE_INT_RGB);
+        var graphics = canvas.createGraphics();
+        try {
+            graphics.setFont(new java.awt.Font(java.awt.Font.DIALOG, java.awt.Font.PLAIN, 30));
+            String cluster = "🧑‍⚖️";
+            String input = ("가" + cluster + "é").repeat(20);
+            var metrics = graphics.getFontMetrics();
+            var lines =
+                    CardRenderer.wrap(input, metrics, Math.max(120, metrics.stringWidth(cluster)));
+            assertThat(String.join("", lines)).isEqualTo(input);
+            assertThat(lines)
+                    .allSatisfy(
+                            line -> {
+                                assertThat(line)
+                                        .doesNotStartWith("‍")
+                                        .doesNotStartWith("️")
+                                        .doesNotStartWith("́")
+                                        .doesNotEndWith("‍");
+                                assertThat(
+                                                Character.isHighSurrogate(
+                                                        line.charAt(line.length() - 1)))
+                                        .isFalse();
+                                assertThat(Character.isLowSurrogate(line.charAt(0))).isFalse();
+                            });
+        } finally {
+            graphics.dispose();
+        }
+    }
+
+    private ShareCardResponse longCard(String statement, String sentenceLabel) {
+        return new ShareCardResponse(
+                "id",
+                "spent",
+                "guilty",
+                "mild",
+                "판".repeat(30),
+                List.of(statement),
+                "oneDay",
+                sentenceLabel,
+                new MemeView("GUILTY_HEAVY", "id", "/api/memes/id/image"));
+    }
+
+    private ShareCardResponse card(String result) {
+        return new ShareCardResponse(
+                "id",
+                "spent",
+                result,
+                "mild",
+                "판결 카드",
+                List.of("공개 문구"),
+                null,
+                null,
+                new MemeView("GUILTY_HEAVY", "id", "/api/memes/id/image"));
+    }
+}
diff --git a/src/test/java/com/ttegeoji/backend/privacy/DeletedPriorPrivacyTest.java b/src/test/java/com/ttegeoji/backend/privacy/DeletedPriorPrivacyTest.java
new file mode 100644
index 0000000000000000000000000000000000000000..18b60ce07b83a5aefbe5c095d4e94bef59bf28d9
--- /dev/null
+++ b/src/test/java/com/ttegeoji/backend/privacy/DeletedPriorPrivacyTest.java
@@ -0,0 +1,170 @@
+package com.ttegeoji.backend.privacy;
+
+import com.ttegeoji.backend.privacy.InvalidationServiceTest.Fixtures;
+import com.ttegeoji.backend.support.PostgresContainerSupport;
+import com.ttegeoji.backend.verdictview.ShareCardAssembler;
+import com.ttegeoji.backend.verdictview.VerdictViewAssembler;
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.DisplayName;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.params.ParameterizedTest;
+import org.junit.jupiter.params.provider.ValueSource;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.boot.test.context.SpringBootTest;
+import org.springframework.jdbc.core.JdbcTemplate;
+import org.springframework.transaction.annotation.Transactional;
+
+import java.util.List;
+import java.util.UUID;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+/** 테스트 트랜잭션은 스케줄러에 보이지 않아 삭제 직후·비동기 정리 전 읽기를 결정적으로 재현한다. */
+@SpringBootTest
+@Transactional
+class DeletedPriorPrivacyTest extends PostgresContainerSupport {
+
+    @Autowired private JdbcTemplate jdbc;
+    @Autowired private InvalidationService service;
+    @Autowired private InvalidationQueries queries;
+    @Autowired private InvalidationScheduler scheduler;
+    @Autowired private VerdictViewAssembler verdictView;
+    @Autowired private ShareCardAssembler shareCard;
+
+    private Fixtures f;
+    private UUID author;
+    private UUID prior;
+
+    @BeforeEach
+    void setUp() {
+        f = new Fixtures(jdbc);
+        author = f.profile();
+        prior = f.post(author);
+    }
+
+    @Test
+    @DisplayName("Q2 POST 무효화 SQL은 같은 게시물의 VERDICT·COMMENT·RULE_HIT 기억도 지우고 다른 게시물은 유지")
+    void deletingPostInvalidatesAllMemoryFactsForItsPayload() {
+        UUID other = f.post(author);
+        List<UUID> target = List.of(memory(prior, "POST", "SPEND"), memory(prior, "VERDICT", "VERDICT"),
+                memory(prior, "COMMENT", "COMMENT"), memory(prior, "RULE", "RULE_HIT"));
+        UUID untouched = memory(other, "VERDICT", "VERDICT");
+
+        service.deletePost(prior, author);
+        // 스케줄러가 실행하는 바로 그 SQL. 현재 트랜잭션의 삭제·PENDING을 다른 스케줄러가 볼 수 없다.
+        queries.runInvalidateScope("POST", prior.toString(), ScopeKeys.post(prior));
+
+        for (UUID fact : target) {
+            assertThat(jdbc.queryForObject("SELECT deleted_at IS NOT NULL FROM ai.memory_facts WHERE id = ?",
+                    Boolean.class, fact)).isTrue();
+        }
+        assertThat(jdbc.queryForObject("SELECT deleted_at IS NULL FROM ai.memory_facts WHERE id = ?",
+                Boolean.class, untouched)).isTrue();
+    }
+
+    @ParameterizedTest
+    @ValueSource(strings = {"POST", "VERDICT", "COMMENT"})
+    @DisplayName("Q3 다른 게시물 PRIOR 삭제 직후 스케줄러 전에도 판결·공유카드에서 인용과 양형이유를 가린다")
+    void deletingPriorImmediatelyHidesCurrentCitation(String sourceType) {
+        UUID current = f.post(author);
+        UUID verdict = f.verdict(current);
+        var ai = f.aiCase(current.toString(), ScopeKeys.post(current));
+        UUID sourceId = sourceId(sourceType);
+        jdbc.update("UPDATE ai.evidence_sources SET source_type = ?, source_id = ? WHERE evidence_id = ?",
+                sourceType, sourceId.toString(), ai.evidence());
+        jdbc.update("UPDATE ai.evidence SET scope = '{\"visibility\":\"PUBLIC\",\"room_ids\":[]}'::jsonb WHERE id = ?",
+                ai.evidence());
+        text(verdict, "mild", ai.dossier());
+        f.ref(verdict, 2, "mild", ai.evidence());
+
+        assertThat(verdictView.assemble(current, author, null).view().source()).isEqualTo("AI");
+        assertThat(shareCard.assemble(current, author).statement()).containsExactly("삭제되면 가려야 하는 과거 사건");
+
+        service.deletePost(prior, author);
+
+        // Q 자체의 epoch는 바뀌지 않고 evidence도 아직 무효화되지 않았다.
+        assertThat(f.epoch(ScopeKeys.post(current))).isZero();
+        assertThat(jdbc.queryForObject("SELECT invalidated_at IS NULL FROM ai.evidence WHERE id = ?",
+                Boolean.class, ai.evidence())).isTrue();
+        var view = verdictView.assemble(current, author, null).view();
+        assertThat(view.source()).isEqualTo("TEMPLATE");
+        assertThat(view.statement()).doesNotContain("삭제되면 가려야 하는 과거 사건");
+        assertThat(view.sentencingReason()).isNull();
+        assertThat(shareCard.assemble(current, author).statement()).doesNotContain("삭제되면 가려야 하는 과거 사건");
+    }
+
+    @Test
+    @DisplayName("Q3 옛 textVersion 인용과 다른 강도 인용은 현재 공개 문구를 가리지 않는다")
+    void oldVersionAndOtherIntensityDoNotBlockCurrentText() {
+        UUID current = f.post(author);
+        UUID verdict = f.verdict(current);
+        var ai = f.aiCase(prior.toString(), ScopeKeys.post(prior));
+        text(verdict, "mild", ai.dossier());
+        f.ref(verdict, 1, "mild", ai.evidence());
+        f.ref(verdict, 2, "spicy", ai.evidence());
+
+        service.deletePost(prior, author);
+
+        assertThat(verdictView.assemble(current, author, null).view().source()).isEqualTo("AI");
+    }
+
+    @ParameterizedTest
+    @ValueSource(strings = {"VERDICT", "COMMENT"})
+    @DisplayName("Q2 POST 작업은 해당 판결·댓글 출처의 근거·조서·prep과 현재 인용 문구도 비동기 정리")
+    void postInvalidationTraversesDerivedSources(String sourceType) {
+        UUID current = f.post(author);
+        UUID verdict = f.verdict(current);
+        var ai = f.aiCase(current.toString(), ScopeKeys.post(current));
+        UUID source = sourceId(sourceType);
+        jdbc.update("UPDATE ai.evidence_sources SET source_type = ?, source_id = ? WHERE evidence_id = ?",
+                sourceType, source.toString(), ai.evidence());
+        text(verdict, "mild", ai.dossier());
+        f.ref(verdict, 2, "mild", ai.evidence());
+
+        service.deletePost(prior, author);
+        queries.runInvalidateScope("POST", prior.toString(), ScopeKeys.post(prior));
+        scheduler.convertAffectedTextsToTemplate(
+                new InvalidationQueries.PendingInvalidation(0, ScopeKeys.post(prior), "POST", prior.toString(), 0));
+
+        assertThat(f.aiState(ai).get("evidence")).isNotNull();
+        assertThat(f.aiState(ai).get("dossier")).isNotNull();
+        assertThat((String) f.aiState(ai).get("trial_prep")).startsWith("INVALIDATED ");
+        assertThat(f.verdictTextRow(verdict, "mild")).containsEntry("source", "TEMPLATE");
+        assertThat(jdbc.queryForObject("SELECT sentence::text FROM verdicts WHERE id = ?", String.class, verdict))
+                .isEqualTo("oneDay");
+    }
+
+    private UUID memory(UUID post, String sourceType, String factType) {
+        UUID id = UUID.randomUUID();
+        jdbc.update("""
+                INSERT INTO ai.memory_facts (id, bank_type, bank_id, fact_type, epistemic_type, source_type,
+                                             source_id, source_version, payload, scope, occurred_at)
+                VALUES (?, 'USER', ?, ?, 'DB_RECORD', ?, ?, 1,
+                        jsonb_build_object('post_id', CAST(? AS text)), '{}'::jsonb, now())""",
+                id, author.toString(), factType, sourceType,
+                "POST".equals(sourceType) ? post.toString() : UUID.randomUUID().toString(), post.toString());
+        return id;
+    }
+
+    private UUID sourceId(String sourceType) {
+        return switch (sourceType) {
+            case "VERDICT" -> f.verdict(prior);
+            case "COMMENT" -> {
+                UUID room = f.room(author);
+                yield jdbc.queryForObject("""
+                        INSERT INTO post_comments (post_id, room_id, user_id, content)
+                        VALUES (?, ?, ?, '과거 댓글') RETURNING id""", UUID.class, prior, room, author);
+            }
+            default -> prior;
+        };
+    }
+
+    private void text(UUID verdict, String intensity, UUID dossier) {
+        f.verdictText(verdict, intensity, 2);
+        jdbc.update("""
+                UPDATE verdict_texts SET statement = '[{"text":"삭제되면 가려야 하는 과거 사건", "kind":"fact", "evidence_labels":["F1"]}]'::jsonb,
+                       dossier_id = ?, privacy_epoch_snapshot = '[]'::jsonb
+                 WHERE verdict_id = ? AND intensity = CAST(? AS spice_level)""", dossier, verdict, intensity);
+        jdbc.update("UPDATE verdicts SET sentencing_reason = '과거 사건을 인용한 양형 이유' WHERE id = ?", verdict);
+    }
+}
