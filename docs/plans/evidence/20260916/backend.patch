diff --git a/src/main/java/com/ttegeoji/backend/api/MediaController.java b/src/main/java/com/ttegeoji/backend/api/MediaController.java
new file mode 100644
index 0000000000000000000000000000000000000000..9b9ec06ed15fbfe1eba4ca097971642c7141a2c1
--- /dev/null
+++ b/src/main/java/com/ttegeoji/backend/api/MediaController.java
@@ -0,0 +1,215 @@
+package com.ttegeoji.backend.api;
+
+import com.ttegeoji.backend.media.CardService;
+import com.ttegeoji.backend.media.ImageService;
+import com.ttegeoji.backend.security.CurrentUser;
+
+import lombok.RequiredArgsConstructor;
+
+import org.springframework.http.CacheControl;
+import org.springframework.http.HttpHeaders;
+import org.springframework.http.MediaType;
+import org.springframework.http.ResponseEntity;
+import org.springframework.security.core.annotation.AuthenticationPrincipal;
+import org.springframework.security.oauth2.jwt.Jwt;
+import org.springframework.web.bind.annotation.*;
+import org.springframework.web.multipart.MultipartFile;
+
+import java.util.List;
+import java.util.Map;
+import java.util.UUID;
+
+@RestController
+@RequiredArgsConstructor
+public class MediaController {
+    private final CardService cards;
+    private final ImageService images;
+
+    public record TransformRequest(String operation) {}
+
+    public record ReviewRequest(Boolean approved) {}
+
+    public record ImageReviewRequest(Boolean approved, String version) {}
+
+    public record ActiveRequest(Boolean active) {}
+
+    public record VersionRequest(String version) {}
+
+    public record SharingRequest(Boolean enabled) {}
+
+    @PostMapping("/api/posts/{postId}/share-card/render")
+    public ResponseEntity<CardService.CardView> render(
+            @AuthenticationPrincipal Jwt jwt, @PathVariable UUID postId) {
+        return ResponseEntity.accepted().body(cards.request(postId, CurrentUser.idOf(jwt), false));
+    }
+
+    @GetMapping("/api/posts/{postId}/share-card/render")
+    public CardService.CardView card(@AuthenticationPrincipal Jwt jwt, @PathVariable UUID postId) {
+        return cards.status(postId, CurrentUser.idOf(jwt));
+    }
+
+    @PostMapping("/api/posts/{postId}/share-card/render/retry")
+    public ResponseEntity<CardService.CardView> retry(
+            @AuthenticationPrincipal Jwt jwt, @PathVariable UUID postId) {
+        return ResponseEntity.accepted().body(cards.request(postId, CurrentUser.idOf(jwt), true));
+    }
+
+    @PutMapping("/api/posts/{postId}/share-card/sharing")
+    public Map<String, Boolean> sharing(
+            @AuthenticationPrincipal Jwt jwt,
+            @PathVariable UUID postId,
+            @RequestBody SharingRequest request) {
+        if (request.enabled() == null) throw new IllegalArgumentException("enabled가 필요합니다.");
+        cards.sharing(postId, CurrentUser.idOf(jwt), request.enabled());
+        return Map.of("enabled", request.enabled());
+    }
+
+    @GetMapping("/api/posts/{postId}/share-card/png")
+    public ResponseEntity<byte[]> png(@AuthenticationPrincipal Jwt jwt, @PathVariable UUID postId) {
+        return bytes(cards.content(postId, CurrentUser.idOf(jwt)), null);
+    }
+
+    @GetMapping("/api/posts/{postId}/share-card/download")
+    public ResponseEntity<byte[]> download(
+            @AuthenticationPrincipal Jwt jwt, @PathVariable UUID postId) {
+        return bytes(cards.content(postId, CurrentUser.idOf(jwt)), "verdict-" + postId + ".png");
+    }
+
+    @PostMapping(value = "/api/images", consumes = MediaType.MULTIPART_FORM_DATA_VALUE)
+    public ResponseEntity<ImageService.ImageView> upload(
+            @AuthenticationPrincipal Jwt jwt, @RequestParam MultipartFile file) {
+        return ResponseEntity.status(201).body(images.upload(CurrentUser.idOf(jwt), file));
+    }
+
+    @GetMapping("/api/images/{id}")
+    public ImageService.ImageView image(@AuthenticationPrincipal Jwt jwt, @PathVariable UUID id) {
+        return images.get(CurrentUser.idOf(jwt), id);
+    }
+
+    @GetMapping("/api/images/{id}/content")
+    public ResponseEntity<byte[]> imageContent(
+            @AuthenticationPrincipal Jwt jwt, @PathVariable UUID id) {
+        return bytes(images.content(CurrentUser.idOf(jwt), id), null);
+    }
+
+    @PostMapping("/api/images/{id}/review")
+    public ImageService.ImageView reviewImage(
+            @AuthenticationPrincipal Jwt jwt,
+            @PathVariable UUID id,
+            @RequestBody ImageReviewRequest request) {
+        if (request.approved() == null) throw new IllegalArgumentException("approved가 필요합니다.");
+        return images.reviewImage(CurrentUser.idOf(jwt), id, request.approved(), request.version());
+    }
+
+    @PostMapping("/api/images/{id}/transform")
+    public ResponseEntity<ImageService.TransformView> transform(
+            @AuthenticationPrincipal Jwt jwt,
+            @PathVariable UUID id,
+            @RequestBody TransformRequest request) {
+        return ResponseEntity.accepted()
+                .body(images.transform(CurrentUser.idOf(jwt), id, request.operation()));
+    }
+
+    @GetMapping("/api/images/{id}/transform")
+    public ImageService.TransformView transformStatus(
+            @AuthenticationPrincipal Jwt jwt, @PathVariable UUID id) {
+        return images.transformation(CurrentUser.idOf(jwt), id);
+    }
+
+    @GetMapping("/api/images/{id}/transform/content")
+    public ResponseEntity<byte[]> transformed(
+            @AuthenticationPrincipal Jwt jwt, @PathVariable UUID id) {
+        return bytes(images.transformedContent(CurrentUser.idOf(jwt), id), null);
+    }
+
+    @PostMapping(value = "/api/admin/memes", consumes = MediaType.MULTIPART_FORM_DATA_VALUE)
+    public ResponseEntity<ImageService.CatalogView> register(
+            @AuthenticationPrincipal Jwt jwt,
+            @RequestParam MultipartFile file,
+            @RequestParam String tag,
+            @RequestParam(required = false) String strategies,
+            @RequestParam(required = false) String emotions,
+            @RequestParam(required = false) String keywords) {
+        return ResponseEntity.status(201)
+                .body(
+                        images.register(
+                                CurrentUser.idOf(jwt), file, tag, strategies, emotions, keywords));
+    }
+
+    @GetMapping("/api/admin/memes")
+    public List<ImageService.CatalogView> catalog(@AuthenticationPrincipal Jwt jwt) {
+        return images.list(CurrentUser.idOf(jwt));
+    }
+
+    @PostMapping("/api/admin/memes/{id}/review")
+    public ImageService.CatalogView review(
+            @AuthenticationPrincipal Jwt jwt,
+            @PathVariable UUID id,
+            @RequestBody ReviewRequest request) {
+        if (request.approved() == null) throw new IllegalArgumentException("approved가 필요합니다.");
+        return images.review(CurrentUser.idOf(jwt), id, request.approved());
+    }
+
+    @PutMapping("/api/admin/memes/{id}/active")
+    public ImageService.CatalogView active(
+            @AuthenticationPrincipal Jwt jwt,
+            @PathVariable UUID id,
+            @RequestBody ActiveRequest request) {
+        if (request.active() == null) throw new IllegalArgumentException("active가 필요합니다.");
+        return images.active(CurrentUser.idOf(jwt), id, request.active());
+    }
+
+    @GetMapping("/api/admin/memes/{id}/image")
+    public ResponseEntity<byte[]> adminImage(
+            @AuthenticationPrincipal Jwt jwt, @PathVariable UUID id) {
+        return bytes(images.adminContent(CurrentUser.idOf(jwt), id), null);
+    }
+
+    @PostMapping("/api/admin/memes/{id}/transform")
+    public ResponseEntity<ImageService.TransformView> adminTransform(
+            @AuthenticationPrincipal Jwt jwt,
+            @PathVariable UUID id,
+            @RequestBody TransformRequest request) {
+        return ResponseEntity.accepted()
+                .body(images.adminTransform(CurrentUser.idOf(jwt), id, request.operation()));
+    }
+
+    @GetMapping("/api/admin/memes/{id}/transform")
+    public ImageService.TransformView adminTransformation(
+            @AuthenticationPrincipal Jwt jwt, @PathVariable UUID id) {
+        return images.adminTransformation(CurrentUser.idOf(jwt), id);
+    }
+
+    @GetMapping("/api/admin/memes/{id}/transform/content")
+    public ResponseEntity<byte[]> adminTransformed(
+            @AuthenticationPrincipal Jwt jwt, @PathVariable UUID id) {
+        return bytes(images.adminTransformedContent(CurrentUser.idOf(jwt), id), null);
+    }
+
+    @PutMapping("/api/admin/memes/{id}/image-version")
+    public ImageService.CatalogView selectVersion(
+            @AuthenticationPrincipal Jwt jwt,
+            @PathVariable UUID id,
+            @RequestBody VersionRequest request) {
+        return images.selectVersion(CurrentUser.idOf(jwt), id, request.version());
+    }
+
+    @GetMapping("/api/memes/{id}/image")
+    public ResponseEntity<byte[]> meme(@PathVariable UUID id) {
+        return bytes(images.memeContent(id), null);
+    }
+
+    private static ResponseEntity<byte[]> bytes(ImageService.ImageBytes image, String filename) {
+        var builder =
+                ResponseEntity.ok()
+                        .contentType(MediaType.parseMediaType(image.mimeType()))
+                        .cacheControl(CacheControl.noStore())
+                        .header("X-Content-Type-Options", "nosniff")
+                        .header("X-Content-SHA256", image.hash())
+                        .eTag(image.hash());
+        if (filename != null)
+            builder.header(
+                    HttpHeaders.CONTENT_DISPOSITION, "attachment; filename=\"" + filename + "\"");
+        return builder.body(image.bytes());
+    }
+}
diff --git a/src/main/java/com/ttegeoji/backend/api/PostDetailController.java b/src/main/java/com/ttegeoji/backend/api/PostDetailController.java
