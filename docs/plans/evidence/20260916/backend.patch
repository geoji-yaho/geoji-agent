diff --git a/src/main/java/com/ttegeoji/backend/media/CardRenderer.java b/src/main/java/com/ttegeoji/backend/media/CardRenderer.java
new file mode 100644
index 0000000000000000000000000000000000000000..99f0e2ab44ac0dbf28adfdaee9521272a91bac5d
--- /dev/null
+++ b/src/main/java/com/ttegeoji/backend/media/CardRenderer.java
@@ -0,0 +1,194 @@
+package com.ttegeoji.backend.media;
+
+import com.ttegeoji.backend.verdictview.dto.ShareCardResponse;
+
+import org.springframework.stereotype.Component;
+
+import java.awt.Color;
+import java.awt.Font;
+import java.awt.FontMetrics;
+import java.awt.Graphics2D;
+import java.awt.RenderingHints;
+import java.awt.image.BufferedImage;
+import java.io.ByteArrayInputStream;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.regex.Pattern;
+
+import javax.imageio.ImageIO;
+
+/** 공유 카드 DTO만 받는다. 원문/양형 이유/투표 내역을 렌더러에 전달할 수 없다. */
+@Component
+public class CardRenderer {
+    public static final String TEMPLATE_VERSION = "share-card-v3";
+    private static final int TEXT_WIDTH = 950;
+    private static final int BODY_BASELINE = 980;
+    private static final int BODY_BOTTOM = 1270;
+    private static final Pattern GRAPHEME = Pattern.compile("\\X");
+    private final Font font;
+    private final String fontHash;
+
+    public CardRenderer(MediaProperties properties) {
+        Font loaded = null;
+        String hash = "missing-font";
+        try {
+            if (properties.fontPath() != null) {
+                byte[] bytes = Files.readAllBytes(properties.fontPath());
+                hash = MediaStorage.hash(bytes);
+                loaded = Font.createFonts(new ByteArrayInputStream(bytes))[0];
+                if (loaded.canDisplayUpTo("떼거지 판결 공유 유죄 무죄") != -1) loaded = null;
+            }
+        } catch (Exception ignored) {
+            /* 서버 API는 기동하고 카드 작업만 FONT_UNAVAILABLE로 실패시킨다. */
+        }
+        font = loaded;
+        fontHash = MediaStorage.hash(hash.getBytes(StandardCharsets.UTF_8));
+    }
+
+    public String fontHash() {
+        return fontHash;
+    }
+
+    public byte[] render(ShareCardResponse card, byte[] meme) throws Exception {
+        if (font == null) throw new IllegalStateException("FONT_UNAVAILABLE");
+        var canvas = new BufferedImage(1080, 1440, BufferedImage.TYPE_INT_RGB);
+        var g = canvas.createGraphics();
+        try {
+            g.setRenderingHint(
+                    RenderingHints.KEY_TEXT_ANTIALIASING, RenderingHints.VALUE_TEXT_ANTIALIAS_ON);
+            g.setRenderingHint(
+                    RenderingHints.KEY_INTERPOLATION, RenderingHints.VALUE_INTERPOLATION_BICUBIC);
+            g.setColor(new Color(249, 247, 242));
+            g.fillRect(0, 0, 1080, 1440);
+            g.setColor(new Color(35, 35, 30));
+            g.setFont(font.deriveFont(Font.BOLD, 32f));
+            g.drawString("떼거지 · 소비 재판  /  " + juryLabel(card.juryStatus()), 64, 86);
+            g.setColor(new Color(221, 83, 46));
+            g.fillRect(64, 112, 952, 5);
+            g.setColor(new Color(35, 35, 30));
+            g.setFont(font.deriveFont(Font.BOLD, 54f));
+            int y = 190;
+            for (String line : fixedLines(card.headline(), g.getFontMetrics(), 3)) {
+                g.drawString(line, 64, y);
+                y += 68;
+            }
+            if (meme != null) {
+                var image = ImageIO.read(new ByteArrayInputStream(meme));
+                if (image == null) throw new IllegalArgumentException("MEME_DECODE_FAILED");
+                double scale = Math.min(952.0 / image.getWidth(), 550.0 / image.getHeight());
+                int w = (int) (image.getWidth() * scale), h = (int) (image.getHeight() * scale);
+                g.drawImage(image, (1080 - w) / 2, 360 + (550 - h) / 2, w, h, null);
+            } else {
+                g.setColor(new Color(237, 232, 220));
+                g.fillRoundRect(64, 360, 952, 550, 24, 24);
+                g.setColor(new Color(95, 90, 80));
+                g.setFont(font.deriveFont(Font.BOLD, 58f));
+                g.drawString(
+                        switch (card.juryStatus()) {
+                            case "guilty" -> "유죄";
+                            case "notGuilty" -> "무죄";
+                            case "agree" -> "동의";
+                            default -> "기각";
+                        },
+                        420,
+                        650);
+            }
+            g.setColor(new Color(35, 35, 30));
+            TextBlock body = fitBody(String.join(" ", card.statement()), g);
+            g.setFont(body.font());
+            y = BODY_BASELINE;
+            for (String line : body.lines()) {
+                g.drawString(line, 64, y);
+                y += body.lineHeight();
+            }
+            // 형량은 본문 길이와 무관한 영역에 두어 최대 두 줄과 footer 사이 여백을 유지한다.
+            g.setFont(font.deriveFont(Font.BOLD, 30f));
+            y = 1310;
+            if (card.sentenceLabel() != null) {
+                for (String line : fixedLines(card.sentenceLabel(), g.getFontMetrics(), 2)) {
+                    g.drawString(line, 64, y);
+                    y += 36;
+                }
+            }
+            g.setColor(new Color(130, 122, 107));
+            g.setFont(font.deriveFont(22f));
+            g.drawString("함께 판단하고, 다음 소비는 더 신중하게.", 64, 1380);
+        } finally {
+            g.dispose();
+        }
+        return MediaStorage.png(canvas);
+    }
+
+    private static String juryLabel(String result) {
+        return switch (result) {
+            case "guilty" -> "유죄";
+            case "notGuilty" -> "무죄";
+            case "agree" -> "동의";
+            case "disagree" -> "기각";
+            default -> "각하";
+        };
+    }
+
+    private record TextBlock(Font font, List<String> lines, int lineHeight) {}
+
+    private TextBlock fitBody(String text, Graphics2D graphics) {
+        String normalized = normalizeWhitespace(text);
+        for (int size = 33; size >= 22; size--) {
+            Font candidate = font.deriveFont((float) size);
+            FontMetrics metrics = graphics.getFontMetrics(candidate);
+            List<String> lines = wrap(normalized, metrics, TEXT_WIDTH);
+            int lineHeight = (int) Math.ceil(metrics.getHeight() * 1.1);
+            int bottom =
+                    BODY_BASELINE
+                            + Math.max(0, lines.size() - 1) * lineHeight
+                            + metrics.getDescent();
+            if (bottom <= BODY_BOTTOM) {
+                return new TextBlock(candidate, lines, lineHeight);
+            }
+        }
+        // 계약 범위를 벗어나더라도 공개 문구를 조용히 잘라 READY로 저장하지 않는다.
+        throw new IllegalStateException("CARD_TEXT_OVERFLOW");
+    }
+
+    private static List<String> fixedLines(String text, FontMetrics metrics, int maximum) {
+        List<String> lines = wrap(normalizeWhitespace(text), metrics, TEXT_WIDTH);
+        if (lines.size() > maximum) throw new IllegalStateException("CARD_TEXT_OVERFLOW");
+        return lines;
+    }
+
+    static String normalizeWhitespace(String text) {
+        var normalized = new StringBuilder();
+        boolean pendingSpace = false;
+        for (int cp : text.codePoints().toArray()) {
+            if (Character.isWhitespace(cp) || Character.isSpaceChar(cp)) {
+                pendingSpace = !normalized.isEmpty();
+            } else {
+                if (pendingSpace) normalized.append(' ');
+                normalized.appendCodePoint(cp);
+                pendingSpace = false;
+            }
+        }
+        return normalized.toString();
+    }
+
+    /** 글자 묶음 단위로 줄바꿈하여 서로게이트 쌍·결합 문자·emoji ZWJ를 중간에서 자르지 않는다. */
+    static List<String> wrap(String text, FontMetrics metrics, int width) {
+        var lines = new ArrayList<String>();
+        var line = new StringBuilder();
+        var graphemes = GRAPHEME.matcher(text);
+        while (graphemes.find()) {
+            String next = graphemes.group();
+            if (!line.isEmpty() && metrics.stringWidth(line + next) > width) {
+                lines.add(line.toString());
+                line.setLength(0);
+            }
+            if (metrics.stringWidth(next) > width)
+                throw new IllegalStateException("CARD_TEXT_OVERFLOW");
+            line.append(next);
+        }
+        if (!line.isEmpty()) lines.add(line.toString());
+        return List.copyOf(lines);
+    }
+}
diff --git a/src/main/java/com/ttegeoji/backend/media/CardService.java b/src/main/java/com/ttegeoji/backend/media/CardService.java
new file mode 100644
index 0000000000000000000000000000000000000000..569e86e877cf3bdc1821367b3e7152f17dcc68e3
--- /dev/null
+++ b/src/main/java/com/ttegeoji/backend/media/CardService.java
@@ -0,0 +1,283 @@
+package com.ttegeoji.backend.media;
+
+import com.ttegeoji.backend.verdictview.PublicApiRejection;
+import com.ttegeoji.backend.verdictview.ShareCardAssembler;
+import com.ttegeoji.backend.verdictview.dto.ShareCardResponse;
+
+import org.springframework.http.HttpStatus;
+import org.springframework.jdbc.core.JdbcTemplate;
+import org.springframework.stereotype.Service;
+import org.springframework.web.server.ResponseStatusException;
+
+import tools.jackson.databind.json.JsonMapper;
+
+import java.net.HttpURLConnection;
+import java.net.URI;
+import java.nio.charset.StandardCharsets;
+import java.util.UUID;
+
+@Service
+public class CardService {
+    private static final JsonMapper JSON = JsonMapper.builder().build();
+    private final JdbcTemplate jdbc;
+    private final ShareCardAssembler assembler;
+    private final MediaStorage storage;
+    private final ImageService images;
+    private final CardRenderer renderer;
+    private final MediaProperties properties;
+
+    public CardService(
+            JdbcTemplate jdbc,
+            ShareCardAssembler assembler,
+            MediaStorage storage,
+            ImageService images,
+            CardRenderer renderer,
+            MediaProperties properties) {
+        this.jdbc = jdbc;
+        this.assembler = assembler;
+        this.storage = storage;
+        this.images = images;
+        this.renderer = renderer;
+        this.properties = properties;
+    }
+
+    public record CardView(
+            UUID id,
+            UUID postId,
+            String status,
+            String inputHash,
+            String pngSha256,
+            String pngUrl,
+            String downloadUrl,
+            String errorCode) {}
+
+    private record Input(
+            ShareCardResponse card,
+            String json,
+            String hash,
+            String memeHash,
+            boolean memeUnavailable) {}
+
+    public CardView request(UUID post, UUID user, boolean retry) {
+        Input input = input(post, user);
+        jdbc.update(
+                """
+                INSERT INTO share_card_jobs(post_id,requested_by,input_hash,input_json,meme_sha256,font_sha256)
+                VALUES (?,?,?,?::jsonb,?,?) ON CONFLICT(post_id,input_hash) DO NOTHING
+                """,
+                post,
+                user,
+                input.hash(),
+                input.json(),
+                input.memeHash(),
+                renderer.fontHash());
+        if (retry)
+            jdbc.update(
+                    """
+                    UPDATE share_card_jobs SET status='PENDING',error_code=NULL,requested_by=?,updated_at=now()
+                    WHERE post_id=? AND input_hash=? AND status='FAILED'
+                    """,
+                    user,
+                    post,
+                    input.hash());
+        return find(post, input.hash());
+    }
+
+    public CardView status(UUID post, UUID user) {
+        return find(post, input(post, user).hash());
+    }
+
+    public ImageService.ImageBytes content(UUID post, UUID user) {
+        CardView row = status(post, user);
+        if (!row.status().equals("READY"))
+            throw new ResponseStatusException(HttpStatus.CONFLICT, "카드가 아직 준비되지 않았습니다.");
+        return new ImageService.ImageBytes(
+                storage.get(row.pngSha256()), "image/png", row.pngSha256());
+    }
+
+    public void sharing(UUID post, UUID user, boolean enabled) {
+        if (!Boolean.TRUE.equals(
+                jdbc.queryForObject(
+                        "SELECT EXISTS(SELECT 1 FROM posts WHERE id=? AND author_id=? AND"
+                            + " deleted_at IS NULL)",
+                        Boolean.class,
+                        post,
+                        user))) throw missing();
+        jdbc.update(
+                """
+                INSERT INTO share_card_sharing(post_id,enabled) VALUES (?,?)
+                ON CONFLICT(post_id) DO UPDATE SET enabled=EXCLUDED.enabled,updated_at=now()
+                """,
+                post,
+                enabled);
+    }
+
+    private CardView find(UUID post, String hash) {
+        return jdbc
+                .query(
+                        "SELECT * FROM share_card_jobs WHERE post_id=? AND input_hash=?",
+                        (r, n) -> {
+                            boolean ready = "READY".equals(r.getString("status"));
+                            String base = "/api/posts/" + post + "/share-card";
+                            return new CardView(
+                                    r.getObject("id", UUID.class),
+                                    post,
+                                    r.getString("status"),
+                                    r.getString("input_hash"),
+                                    r.getString("png_sha256"),
+                                    ready ? base + "/png" : null,
+                                    ready ? base + "/download" : null,
+                                    r.getString("error_code"));
+                        },
+                        post,
+                        hash)
+                .stream()
+                .findFirst()
+                .orElseThrow(CardService::missing);
+    }
+
+    private Input input(UUID post, UUID user) {
+        ShareCardResponse card;
+        try {
+            card = assembler.assemble(post, user);
+        } catch (PublicApiRejection e) {
+            throw new ResponseStatusException(e.getStatus(), e.getMessage());
+        }
+        if (Boolean.TRUE.equals(
+                jdbc.queryForObject(
+                        "SELECT EXISTS(SELECT 1 FROM share_card_sharing WHERE post_id=? AND NOT"
+                            + " enabled)",
+                        Boolean.class,
+                        post))) throw missing();
+        String memeHash = null;
+        boolean memeUnavailable = false;
+        if (card.meme() != null && card.meme().imageUrl() != null) {
+            String url = card.meme().imageUrl();
+            byte[] bytes;
+            try {
+                if (url.matches("/api/memes/[a-f0-9-]+/image"))
+                    bytes = images.memeContent(UUID.fromString(card.meme().imageId())).bytes();
+                else bytes = fetchAllowedImage(url);
+                storage.validate(bytes);
+                memeHash = storage.put(bytes);
+            } catch (RuntimeException e) {
+                // 선택된 짤을 조용히 생략하지 않는다. 카드 작업만 실패 상태로 남겨 재시도하게 한다.
+                memeUnavailable = true;
+            }
+        }
+        String json = JSON.writeValueAsString(card);
+        String hash =
+                MediaStorage.hash(
+                        (CardRenderer.TEMPLATE_VERSION
+                                        + ":"
+                                        + renderer.fontHash()
+                                        + ":"
+                                        + memeHash
+                                        + ":"
+                                        + memeUnavailable
+                                        + ":"
+                                        + json)
+                                .getBytes(StandardCharsets.UTF_8));
+        return new Input(card, json, hash, memeHash, memeUnavailable);
+    }
+
+    /** 원격 이미지 URL은 배포자가 명시한 origin 하나에 한정하고 redirect/큰 파일/무한 대기를 금지한다. */
+    private byte[] fetchAllowedImage(String url) {
+        HttpURLConnection connection = null;
+        try {
+            URI uri = URI.create(url);
+            URI allowed = URI.create(properties.sourceOrigin());
+            if (uri.getUserInfo() != null
+                    || uri.getFragment() != null
+                    || !java.util.Set.of("http", "https").contains(uri.getScheme())
+                    || !uri.getScheme().equals(allowed.getScheme())
+                    || !java.util.Objects.equals(uri.getRawAuthority(), allowed.getRawAuthority()))
+                throw new IllegalArgumentException("허용되지 않은 짤 저장소입니다.");
+            connection = (HttpURLConnection) uri.toURL().openConnection();
+            connection.setConnectTimeout(500);
+            connection.setReadTimeout(2000);
+            connection.setInstanceFollowRedirects(false);
+            if (connection.getResponseCode() != 200)
+                throw new IllegalStateException("짤 이미지를 읽을 수 없습니다.");
+            if (connection.getContentLengthLong() > MediaStorage.MAX_BYTES)
+                throw new IllegalArgumentException("짤 이미지가 너무 큽니다.");
+            try (var stream = connection.getInputStream()) {
+                byte[] bytes = stream.readNBytes(MediaStorage.MAX_BYTES + 1);
+                storage.validate(bytes);
+                return bytes;
+            }
+        } catch (java.io.IOException e) {
+            throw new IllegalStateException("짤 이미지 로딩 실패", e);
+        } finally {
+            if (connection != null) connection.disconnect();
+        }
+    }
+
+    public boolean runCard() {
+        UUID token = UUID.randomUUID();
+        var jobs =
+                jdbc.queryForList(
+                        """
+                        WITH next AS (SELECT id FROM share_card_jobs WHERE status='PENDING'
+                        OR (status='RENDERING' AND lease_until<now()) ORDER BY created_at FOR UPDATE SKIP LOCKED LIMIT 1)
+                        UPDATE share_card_jobs j SET status='RENDERING',lease_token=?,lease_until=now()+interval '30 seconds',
+                        attempts=attempts+1,updated_at=now() FROM next WHERE j.id=next.id RETURNING j.*
+                        """,
+                        token);
+        if (jobs.isEmpty()) return false;
+        var job = jobs.getFirst();
+        UUID id = (UUID) job.get("id");
+        UUID post = (UUID) job.get("post_id");
+        UUID user = (UUID) job.get("requested_by");
+        try {
+            Input current = input(post, user);
+            if (current.memeUnavailable()) throw new IllegalStateException("MEME_UNAVAILABLE");
+            if (!current.hash().equals(job.get("input_hash")))
+                throw new IllegalStateException("INPUT_CHANGED");
+            String recipe = current.hash();
+            byte[] bytes = storage.derived(recipe);
+            if (bytes == null) {
+                bytes =
+                        renderer.render(
+                                current.card(),
+                                current.memeHash() == null
+                                        ? null
+                                        : storage.get(current.memeHash()));
+                storage.saveDerived(recipe, bytes);
+            }
+            String hash = storage.put(bytes);
+            if (!input(post, user).hash().equals(current.hash()))
+                throw new IllegalStateException("INPUT_CHANGED");
+            jdbc.update(
+                    "UPDATE share_card_jobs SET"
+                        + " status='READY',png_sha256=?,error_code=NULL,lease_until=NULL,updated_at=now()"
+                        + " WHERE id=? AND lease_token=?",
+                    hash,
+                    id,
+                    token);
+        } catch (Exception e) {
+            String code =
+                    e instanceof ResponseStatusException
+                            ? "ACCESS_REVOKED"
+                            : "FONT_UNAVAILABLE".equals(e.getMessage())
+                                    ? "FONT_UNAVAILABLE"
+                                    : "INPUT_CHANGED".equals(e.getMessage())
+                                            ? "INPUT_CHANGED"
+                                            : "MEME_UNAVAILABLE".equals(e.getMessage())
+                                                    ? "MEME_UNAVAILABLE"
+                                                    : "RENDER_FAILED";
+            jdbc.update(
+                    "UPDATE share_card_jobs SET"
+                        + " status='FAILED',error_code=?,lease_until=NULL,updated_at=now() WHERE"
+                        + " id=? AND lease_token=?",
+                    code,
+                    id,
+                    token);
+        }
+        return true;
+    }
+
+    private static ResponseStatusException missing() {
+        return new ResponseStatusException(HttpStatus.NOT_FOUND, "공유 카드가 없습니다.");
+    }
+}
diff --git a/src/main/java/com/ttegeoji/backend/media/ImageService.java b/src/main/java/com/ttegeoji/backend/media/ImageService.java
new file mode 100644
index 0000000000000000000000000000000000000000..fb970d9da8710946a6e367a00ca878ea210a8c28
--- /dev/null
+++ b/src/main/java/com/ttegeoji/backend/media/ImageService.java
@@ -0,0 +1,497 @@
+package com.ttegeoji.backend.media;
+
+import com.ttegeoji.backend.domain.enums.MemeTag;
+
+import org.springframework.http.HttpStatus;
+import org.springframework.jdbc.core.JdbcTemplate;
+import org.springframework.stereotype.Service;
+import org.springframework.transaction.PlatformTransactionManager;
+import org.springframework.transaction.support.TransactionTemplate;
+import org.springframework.web.multipart.MultipartFile;
+import org.springframework.web.server.ResponseStatusException;
+
+import java.awt.image.BufferedImage;
+import java.io.ByteArrayInputStream;
+import java.nio.charset.StandardCharsets;
+import java.util.Arrays;
+import java.util.List;
+import java.util.Set;
+import java.util.UUID;
+
+import javax.imageio.ImageIO;
+
+@Service
+public class ImageService {
+    public static final String TRANSFORM_VERSION = "grayscale-v1";
+    private final JdbcTemplate jdbc;
+    private final MediaStorage storage;
+    private final MediaProperties properties;
+    private final TransactionTemplate tx;
+
+    public ImageService(
+            JdbcTemplate jdbc,
+            MediaStorage storage,
+            MediaProperties properties,
+            PlatformTransactionManager manager) {
+        this.jdbc = jdbc;
+        this.storage = storage;
+        this.properties = properties;
+        this.tx = new TransactionTemplate(manager);
+    }
+
+    public record ImageView(
+            UUID id,
+            String sha256,
+            String mimeType,
+            int width,
+            int height,
+            String status,
+            String contentUrl,
+            String reviewStatus,
+            String selectedVersion) {}
+
+    public record TransformView(
+            UUID id,
+            UUID imageId,
+            String status,
+            String operation,
+            String sha256,
+            String contentUrl,
+            String errorCode) {}
+
+    public record CatalogView(
+            UUID id,
+            UUID imageId,
+            String tag,
+            boolean approved,
+            boolean active,
+            String imageUrl,
+            String selectedVersion) {}
+
+    public record ImageBytes(byte[] bytes, String mimeType, String hash) {}
+
+    public ImageView upload(UUID user, MultipartFile file) {
+        var image = storage.validate(file);
+        storage.put(image.bytes()); // DB 실패 후 같은 해시 파일을 재사용한다.
+        UUID id =
+                jdbc.queryForObject(
+                        """
+                        INSERT INTO media_images(owner_id,sha256,mime_type,width,height) VALUES (?,?,?,?,?)
+                        ON CONFLICT(owner_id,sha256) DO UPDATE SET sha256=EXCLUDED.sha256 RETURNING id
+                        """,
+                        UUID.class,
+                        user,
+                        image.sha256(),
+                        image.mimeType(),
+                        image.width(),
+                        image.height());
+        return get(user, id);
+    }
+
+    public ImageView get(UUID user, UUID id) {
+        return jdbc
+                .query(
+                        "SELECT * FROM media_images WHERE id=? AND owner_id=?",
+                        (r, n) ->
+                                new ImageView(
+                                        r.getObject("id", UUID.class),
+                                        r.getString("sha256"),
+                                        r.getString("mime_type"),
+                                        r.getInt("width"),
+                                        r.getInt("height"),
+                                        "PRIVATE",
+                                        "/api/images/" + id + "/content",
+                                        r.getString("review_status"),
+                                        r.getString("selected_version")),
+                        id,
+                        user)
+                .stream()
+                .findFirst()
+                .orElseThrow(ImageService::notFound);
+    }
+
+    public ImageView reviewImage(UUID user, UUID id, boolean approved, String version) {
+        get(user, id);
+        if (!Set.of("ORIGINAL", "GRAYSCALE").contains(version == null ? "" : version))
+            throw new IllegalArgumentException("검수할 버전이 필요합니다.");
+        if (approved
+                && version.equals("GRAYSCALE")
+                && !transformation(user, id).status().equals("READY"))
+            throw new ResponseStatusException(HttpStatus.CONFLICT, "변환 완료 후 검수할 수 있습니다.");
+        jdbc.update(
+                "UPDATE media_images SET review_status=?,selected_version=? WHERE id=? AND"
+                    + " owner_id=?",
+                approved ? "APPROVED" : "REJECTED",
+                approved ? version : null,
+                id,
+                user);
+        return get(user, id);
+    }
+
+    public ImageBytes content(UUID user, UUID id) {
+        var row = get(user, id);
+        return new ImageBytes(storage.get(row.sha256()), row.mimeType(), row.sha256());
+    }
+
+    public TransformView transform(UUID user, UUID id, String operation) {
+        get(user, id);
+        if (!"GRAYSCALE".equals(operation))
+            throw new IllegalArgumentException("지원 변환은 무료 로컬 GRAYSCALE입니다.");
+        jdbc.update(
+                """
+                INSERT INTO media_transforms(image_id,operation,version) VALUES (?, ?, ?)
+                ON CONFLICT(image_id,operation,version) DO UPDATE SET
+                  status=CASE WHEN media_transforms.status='FAILED' THEN 'PENDING' ELSE media_transforms.status END,
+                  error_code=CASE WHEN media_transforms.status='FAILED' THEN NULL ELSE media_transforms.error_code END,
+                  updated_at=now()
+                """,
+                id,
+                operation,
+                TRANSFORM_VERSION);
+        return transformation(user, id);
+    }
+
+    public TransformView transformation(UUID user, UUID id) {
+        get(user, id);
+        return jdbc
+                .query(
+                        "SELECT * FROM media_transforms WHERE image_id=? AND version=?",
+                        (r, n) ->
+                                new TransformView(
+                                        r.getObject("id", UUID.class),
+                                        id,
+                                        r.getString("status"),
+                                        r.getString("operation"),
+                                        r.getString("sha256"),
+                                        "READY".equals(r.getString("status"))
+                                                ? "/api/images/" + id + "/transform/content"
+                                                : null,
+                                        r.getString("error_code")),
+                        id,
+                        TRANSFORM_VERSION)
+                .stream()
+                .findFirst()
+                .orElseThrow(ImageService::notFound);
+    }
+
+    public ImageBytes transformedContent(UUID user, UUID id) {
+        var row = transformation(user, id);
+        if (!"READY".equals(row.status()))
+            throw new ResponseStatusException(HttpStatus.CONFLICT, "변환이 아직 완료되지 않았습니다.");
+        return new ImageBytes(storage.get(row.sha256()), "image/png", row.sha256());
+    }
+
+    public void requireAdmin(UUID user) {
+        if (!properties.adminIds().contains(user))
+            throw new ResponseStatusException(HttpStatus.FORBIDDEN, "관리자 권한이 필요합니다.");
+    }
+
+    public CatalogView register(
+            UUID admin,
+            MultipartFile file,
+            String tag,
+            String strategies,
+            String emotions,
+            String keywords) {
+        requireAdmin(admin);
+        try {
+            MemeTag.valueOf(tag);
+        } catch (RuntimeException e) {
+            throw new IllegalArgumentException("유효한 짤 태그가 필요합니다.");
+        }
+        String[] ss = labels(strategies), ee = labels(emotions), kk = labels(keywords);
+        if (!Set.of(
+                        "DISAPPROVAL",
+                        "ABSURD_SERIOUSNESS",
+                        "SMUG",
+                        "PITY",
+                        "CELEBRATION",
+                        "RESIGNATION")
+                .containsAll(Arrays.asList(ee)))
+            throw new IllegalArgumentException("지원하지 않는 감정입니다.");
+        var image = upload(admin, file);
+        return tx.execute(
+                t -> {
+                    // 동일 관리자 원본의 중복 등록은 기존 카탈로그를 반환하고 승인/태그를 덮어쓰지 않는다.
+                    jdbc.queryForObject(
+                            "SELECT id FROM media_images WHERE id=? FOR UPDATE",
+                            UUID.class,
+                            image.id());
+                    var existing =
+                            jdbc.queryForList(
+                                    "SELECT id FROM meme_catalog_entries WHERE image_id=?",
+                                    UUID.class,
+                                    image.id());
+                    if (!existing.isEmpty()) return catalog(existing.getFirst());
+                    UUID id = UUID.randomUUID();
+                    String url = "/api/memes/" + id + "/image";
+                    jdbc.update(
+                            "INSERT INTO"
+                                + " meme_images(id,tag,strategies,emotions,keywords,image_url,is_active)"
+                                + " VALUES (?,?,?::text[],?::text[],?::text[],?,false)",
+                            id,
+                            tag,
+                            sqlArray(ss),
+                            sqlArray(ee),
+                            sqlArray(kk),
+                            url);
+                    jdbc.update(
+                            "INSERT INTO meme_catalog_entries(id,image_id) VALUES (?,?)",
+                            id,
+                            image.id());
+                    return catalog(id);
+                });
+    }
+
+    public List<CatalogView> list(UUID user) {
+        requireAdmin(user);
+        return jdbc.query(catalogSql() + " ORDER BY m.id", ImageService::catalogRow);
+    }
+
+    public CatalogView review(UUID user, UUID id, boolean approved) {
+        requireAdmin(user);
+        return tx.execute(
+                t -> {
+                    if (jdbc.update(
+                                    "UPDATE meme_catalog_entries SET"
+                                        + " approved=?,reviewed_by=?,reviewed_at=now() WHERE id=?",
+                                    approved,
+                                    user,
+                                    id)
+                            == 0) throw notFound();
+                    if (!approved)
+                        jdbc.update("UPDATE meme_images SET is_active=false WHERE id=?", id);
+                    return catalog(id);
+                });
+    }
+
+    public CatalogView active(UUID user, UUID id, boolean active) {
+        requireAdmin(user);
+        return tx.execute(
+                t -> {
+                    var approved =
+                            jdbc.queryForList(
+                                    "SELECT approved FROM meme_catalog_entries WHERE id=? FOR"
+                                        + " UPDATE",
+                                    Boolean.class,
+                                    id);
+                    if (approved.isEmpty()) throw notFound();
+                    if (active && !approved.getFirst())
+                        throw new ResponseStatusException(
+                                HttpStatus.CONFLICT, "검수 승인 후 활성화할 수 있습니다.");
+                    jdbc.update("UPDATE meme_images SET is_active=? WHERE id=?", active, id);
+                    return catalog(id);
+                });
+    }
+
+    public ImageBytes memeContent(UUID id) {
+        return catalogImage(id, true);
+    }
+
+    public ImageBytes adminContent(UUID user, UUID id) {
+        requireAdmin(user);
+        return catalogImage(id, false);
+    }
+
+    private ImageBytes catalogImage(UUID id, boolean requireActive) {
+        var rows =
+                jdbc.query(
+                        """
+                        SELECT CASE WHEN c.selected_version='GRAYSCALE' THEN t.sha256 ELSE i.sha256 END AS sha256,
+                               CASE WHEN c.selected_version='GRAYSCALE' THEN 'image/png' ELSE i.mime_type END AS mime_type
+                        FROM media_images i JOIN meme_catalog_entries c ON c.image_id=i.id
+                        JOIN meme_images m ON m.id=c.id
+                        LEFT JOIN media_transforms t ON t.image_id=i.id AND t.version=? AND t.status='READY'
+                        WHERE c.id=? AND (NOT ? OR (c.approved AND m.is_active))
+                        """,
+                        (r, n) -> new String[] {r.getString(1), r.getString(2)},
+                        TRANSFORM_VERSION,
+                        id,
+                        requireActive);
+        if (rows.isEmpty() || rows.getFirst()[0] == null) throw notFound();
+        return new ImageBytes(
+                storage.get(rows.getFirst()[0]), rows.getFirst()[1], rows.getFirst()[0]);
+    }
+
+    private UUID catalogOwner(UUID id) {
+        return jdbc
+                .queryForList(
+                        "SELECT i.owner_id FROM media_images i JOIN meme_catalog_entries c ON"
+                            + " c.image_id=i.id WHERE c.id=?",
+                        UUID.class,
+                        id)
+                .stream()
+                .findFirst()
+                .orElseThrow(ImageService::notFound);
+    }
+
+    public TransformView adminTransform(UUID user, UUID id, String operation) {
+        requireAdmin(user);
+        var c = catalog(id);
+        transform(catalogOwner(id), c.imageId(), operation);
+        return adminTransformation(user, id);
+    }
+
+    public TransformView adminTransformation(UUID user, UUID id) {
+        requireAdmin(user);
+        var c = catalog(id);
+        var t = transformation(catalogOwner(id), c.imageId());
+        return new TransformView(
+                t.id(),
+                t.imageId(),
+                t.status(),
+                t.operation(),
+                t.sha256(),
+                t.contentUrl() == null ? null : "/api/admin/memes/" + id + "/transform/content",
+                t.errorCode());
+    }
+
+    public ImageBytes adminTransformedContent(UUID user, UUID id) {
+        requireAdmin(user);
+        return transformedContent(catalogOwner(id), catalog(id).imageId());
+    }
+
+    public CatalogView selectVersion(UUID user, UUID id, String version) {
+        requireAdmin(user);
+        if (!Set.of("ORIGINAL", "GRAYSCALE").contains(version == null ? "" : version))
+            throw new IllegalArgumentException("이미지 버전이 필요합니다.");
+        return tx.execute(
+                t -> {
+                    var selected =
+                            jdbc.queryForList(
+                                    "SELECT selected_version FROM meme_catalog_entries WHERE id=?"
+                                        + " FOR UPDATE",
+                                    String.class,
+                                    id);
+                    if (selected.isEmpty()) throw notFound();
+                    if (selected.getFirst().equals(version)) return catalog(id);
+                    if (version.equals("GRAYSCALE")
+                            && !adminTransformation(user, id).status().equals("READY"))
+                        throw new ResponseStatusException(
+                                HttpStatus.CONFLICT, "변환 완료 후 선택할 수 있습니다.");
+                    jdbc.update(
+                            "UPDATE meme_catalog_entries SET"
+                                + " selected_version=?,approved=false,reviewed_by=NULL,reviewed_at=NULL"
+                                + " WHERE id=?",
+                            version,
+                            id);
+                    jdbc.update("UPDATE meme_images SET is_active=false WHERE id=?", id);
+                    return catalog(id);
+                });
+    }
+
+    private CatalogView catalog(UUID id) {
+        return jdbc.query(catalogSql() + " WHERE m.id=?", ImageService::catalogRow, id).stream()
+                .findFirst()
+                .orElseThrow(ImageService::notFound);
+    }
+
+    private static String catalogSql() {
+        return "SELECT m.id,c.image_id,m.tag,c.approved,m.is_active,m.image_url,c.selected_version"
+                   + " FROM meme_catalog_entries c JOIN meme_images m ON m.id=c.id";
+    }
+
+    private static CatalogView catalogRow(java.sql.ResultSet r, int n)
+            throws java.sql.SQLException {
+        return new CatalogView(
+                r.getObject("id", UUID.class),
+                r.getObject("image_id", UUID.class),
+                r.getString("tag"),
+                r.getBoolean("approved"),
+                r.getBoolean("is_active"),
+                r.getString("image_url"),
+                r.getString("selected_version"));
+    }
+
+    private static String[] labels(String value) {
+        if (value == null || value.isBlank()) return new String[0];
+        String[] labels =
+                Arrays.stream(value.split(","))
+                        .map(String::trim)
+                        .filter(s -> !s.isEmpty())
+                        .distinct()
+                        .toArray(String[]::new);
+        if (labels.length > 20
+                || Arrays.stream(labels)
+                        .anyMatch(
+                                s ->
+                                        s.length() > 60
+                                                || s.contains("{")
+                                                || s.contains("}")
+                                                || s.contains("\\")
+                                                || s.contains("\"")))
+            throw new IllegalArgumentException("태그는 20개 이하, 각 60자 이하이어야 합니다.");
+        return labels;
+    }
+
+    private static String sqlArray(String[] labels) {
+        return "{"
+                + String.join(",", Arrays.stream(labels).map(s -> "\"" + s + "\"").toList())
+                + "}";
+    }
+
+    static ResponseStatusException notFound() {
+        return new ResponseStatusException(HttpStatus.NOT_FOUND, "이미지가 없습니다.");
+    }
+
+    /** claim은 한 SQL로 커밋하고 디코딩/파일 쓰기는 트랜잭션 밖에서 수행한다. lease token이 이전 실행의 완료를 막는다. */
+    public boolean runTransform() {
+        UUID token = UUID.randomUUID();
+        var jobs =
+                jdbc.queryForList(
+                        """
+                        WITH next AS (SELECT id FROM media_transforms WHERE status='PENDING'
+                        OR (status='RENDERING' AND lease_until<now()) ORDER BY created_at FOR UPDATE SKIP LOCKED LIMIT 1)
+                        UPDATE media_transforms j SET status='RENDERING',lease_token=?,lease_until=now()+interval '30 seconds',
+                        attempts=attempts+1,updated_at=now() FROM next WHERE j.id=next.id RETURNING j.*
+                        """,
+                        token);
+        if (jobs.isEmpty()) return false;
+        var job = jobs.getFirst();
+        UUID id = (UUID) job.get("id");
+        try {
+            String source =
+                    jdbc.queryForObject(
+                            "SELECT sha256 FROM media_images WHERE id=?",
+                            String.class,
+                            job.get("image_id"));
+            String recipe =
+                    MediaStorage.hash(
+                            (source + ":" + TRANSFORM_VERSION).getBytes(StandardCharsets.UTF_8));
+            byte[] output = storage.derived(recipe);
+            if (output == null) {
+                var original = ImageIO.read(new ByteArrayInputStream(storage.get(source)));
+                var gray =
+                        new BufferedImage(
+                                original.getWidth(),
+                                original.getHeight(),
+                                BufferedImage.TYPE_BYTE_GRAY);
+                var g = gray.createGraphics();
+                try {
+                    g.drawImage(original, 0, 0, null);
+                } finally {
+                    g.dispose();
+                }
+                output = MediaStorage.png(gray);
+                storage.saveDerived(recipe, output);
+            }
+            storage.validate(output);
+            String hash = storage.put(output);
+            jdbc.update(
+                    "UPDATE media_transforms SET"
+                        + " status='READY',sha256=?,error_code=NULL,lease_until=NULL,updated_at=now()"
+                        + " WHERE id=? AND lease_token=?",
+                    hash,
+                    id,
+                    token);
+        } catch (Exception e) {
+            jdbc.update(
+                    "UPDATE media_transforms SET"
+                        + " status='FAILED',error_code='TRANSFORM_FAILED',lease_until=NULL,updated_at=now()"
+                        + " WHERE id=? AND lease_token=?",
+                    id,
+                    token);
+        }
+        return true;
+    }
+}
