@@ -0,0 +1,57 @@
+package com.ttegeoji.backend.media;
+
+import jakarta.annotation.PostConstruct;
+import jakarta.annotation.PreDestroy;
+
+import lombok.extern.slf4j.Slf4j;
+
+import org.springframework.beans.factory.annotation.Value;
+import org.springframework.stereotype.Component;
+
+import java.util.concurrent.Executors;
+import java.util.concurrent.ScheduledExecutorService;
+import java.util.concurrent.TimeUnit;
+
+/** 디코딩/파일 작업은 판결 watchdog 스케줄러를 막지 않는 전용 실행기에서 수행한다. */
+@Slf4j
+@Component
+@org.springframework.boot.autoconfigure.condition.ConditionalOnProperty(
+        name = "geoji.media.enabled",
+        havingValue = "true",
+        matchIfMissing = true)
+public class MediaWorker {
+    private final CardService cards;
+    private final ImageService images;
+    private final long pollMs;
+    private final ScheduledExecutorService executor =
+            Executors.newSingleThreadScheduledExecutor(
+                    Thread.ofPlatform().daemon(true).name("media-worker").factory());
+
+    public MediaWorker(
+            CardService cards,
+            ImageService images,
+            @Value("${geoji.media.poll-ms:1000}") long pollMs) {
+        this.cards = cards;
+        this.images = images;
+        this.pollMs = Math.max(100, pollMs);
+    }
+
+    @PostConstruct
+    public void start() {
+        executor.scheduleWithFixedDelay(this::poll, pollMs, pollMs, TimeUnit.MILLISECONDS);
+    }
+
+    @PreDestroy
+    public void stop() {
+        executor.shutdownNow();
+    }
+
+    public void poll() {
+        try {
+            cards.runCard();
+            images.runTransform();
+        } catch (Exception e) {
+            log.warn("미디어 작업 재시도 대기: {}", e.getClass().getSimpleName());
+        }
+    }
+}
