diff --git a/src/test/resources/db/004b_media.sql b/src/test/resources/db/004b_media.sql
new file mode 100644
index 0000000000000000000000000000000000000000..6b708751d90f4ef33923f5d911768d994a6cb909
--- /dev/null
+++ b/src/test/resources/db/004b_media.sql
@@ -0,0 +1,62 @@
+-- 로컬 미디어/PNG 작업 초안. 운영 적용은 별도 승인 및 정식 migration 이관 후 수행한다.
+CREATE TABLE media_images (
+    id uuid PRIMARY KEY DEFAULT gen_random_uuid(),
+    owner_id uuid NOT NULL REFERENCES profiles(id),
+    sha256 text NOT NULL CHECK (sha256 ~ '^[0-9a-f]{64}$'),
+    mime_type text NOT NULL CHECK (mime_type IN ('image/png','image/jpeg')),
+    review_status text NOT NULL DEFAULT 'PENDING' CHECK(review_status IN ('PENDING','APPROVED','REJECTED')),
+    selected_version text CHECK(selected_version IN ('ORIGINAL','GRAYSCALE')),
+    width integer NOT NULL CHECK (width BETWEEN 1 AND 4096),
+    height integer NOT NULL CHECK (height BETWEEN 1 AND 4096),
+    created_at timestamptz NOT NULL DEFAULT now(),
+    UNIQUE (owner_id,sha256)
+);
+CREATE TABLE media_transforms (
+    id uuid PRIMARY KEY DEFAULT gen_random_uuid(),
+    image_id uuid NOT NULL REFERENCES media_images(id),
+    operation text NOT NULL CHECK (operation = 'GRAYSCALE'),
+    version text NOT NULL,
+    status text NOT NULL DEFAULT 'PENDING' CHECK (status IN ('PENDING','RENDERING','READY','FAILED')),
+    sha256 text,
+    error_code text,
+    lease_token uuid,
+    lease_until timestamptz,
+    attempts integer NOT NULL DEFAULT 0,
+    created_at timestamptz NOT NULL DEFAULT now(),
+    updated_at timestamptz NOT NULL DEFAULT now(),
+    UNIQUE(image_id,operation,version)
+);
+CREATE TABLE meme_catalog_entries (
+    id uuid PRIMARY KEY REFERENCES meme_images(id),
+    image_id uuid NOT NULL UNIQUE REFERENCES media_images(id),
+    approved boolean NOT NULL DEFAULT false,
+    selected_version text NOT NULL DEFAULT 'ORIGINAL' CHECK (selected_version IN ('ORIGINAL','GRAYSCALE')),
+    reviewed_by uuid REFERENCES profiles(id),
+    reviewed_at timestamptz
+);
+CREATE TABLE share_card_sharing (
+    post_id uuid PRIMARY KEY REFERENCES posts(id),
+    enabled boolean NOT NULL DEFAULT true,
+    updated_at timestamptz NOT NULL DEFAULT now()
+);
+CREATE TABLE share_card_jobs (
+    id uuid PRIMARY KEY DEFAULT gen_random_uuid(),
+    post_id uuid NOT NULL REFERENCES posts(id),
+    requested_by uuid NOT NULL REFERENCES profiles(id),
+    input_hash text NOT NULL,
+    input_json jsonb NOT NULL,
+    meme_sha256 text,
+    font_sha256 text NOT NULL,
+    status text NOT NULL DEFAULT 'PENDING' CHECK (status IN ('PENDING','RENDERING','READY','FAILED')),
+    png_sha256 text,
+    error_code text,
+    lease_token uuid,
+    lease_until timestamptz,
+    attempts integer NOT NULL DEFAULT 0,
+    created_at timestamptz NOT NULL DEFAULT now(),
+    updated_at timestamptz NOT NULL DEFAULT now(),
+    UNIQUE(post_id,input_hash)
+);
+CREATE INDEX share_card_jobs_pending ON share_card_jobs(status,lease_until,created_at);
+CREATE INDEX media_transforms_pending ON media_transforms(status,lease_until,created_at);
+GRANT SELECT,INSERT,UPDATE ON media_images,media_transforms,meme_catalog_entries,share_card_sharing,share_card_jobs TO backend;
diff --git a/src/test/resources/db/004b_submission_idempotency.sql b/src/test/resources/db/004b_submission_idempotency.sql
new file mode 100644
index 0000000000000000000000000000000000000000..f4b628342a88c60987dec73db644f49f94a17138
--- /dev/null
+++ b/src/test/resources/db/004b_submission_idempotency.sql
@@ -0,0 +1,11 @@
+-- 공개 최초 제출의 응답 유실 복구. 키 범위는 사용자별이며 원문 대신 기존 canonical payload hash만 보관한다.
+CREATE TABLE submission_request_keys (
+    actor_id uuid NOT NULL REFERENCES profiles(id),
+    request_key text NOT NULL CHECK (char_length(request_key) BETWEEN 1 AND 128),
+    payload_hash text NOT NULL,
+    submission_id uuid REFERENCES submissions(id),
+    lease_until timestamptz,
+    created_at timestamptz NOT NULL DEFAULT now(),
+    PRIMARY KEY(actor_id,request_key)
+);
+GRANT SELECT,INSERT,UPDATE ON submission_request_keys TO backend;
