@@ -0,0 +1,92 @@
+import { useQuery } from "@tanstack/react-query";
+import { useNavigate, useParams } from "react-router";
+
+import { BackHeader } from "@/shared/components/BackHeader";
+import { Alert } from "@/shared/ui/Alert";
+import { BlobImage } from "@/shared/ui/BlobImage";
+import { Button } from "@/shared/ui/Button";
+
+import { imageQueries } from "../api/images";
+import { useCreateImageTransform, useReviewPrivateImage } from "../hooks/useImageActions";
+
+export function PrivateImagePage() {
+	const { imageId = "" } = useParams();
+	const navigate = useNavigate();
+	const detail = useQuery(imageQueries.detail(imageId));
+	const transform = useQuery({ ...imageQueries.transform(imageId), enabled: Boolean(detail.data) });
+	const original = useQuery({
+		...imageQueries.content(imageId, false, detail.data?.sha256 ?? null),
+		enabled: Boolean(detail.data)
+	});
+	const transformed = useQuery({
+		...imageQueries.content(imageId, true, transform.data?.sha256 ?? null),
+		enabled: transform.data?.status === "READY"
+	});
+	const createTransform = useCreateImageTransform(imageId);
+	const review = useReviewPrivateImage(imageId);
+	const isWorking = transform.data?.status === "PENDING" || transform.data?.status === "RENDERING";
+	const canTransform = !isWorking && transform.data?.status !== "READY" && !createTransform.isPending;
+	const loadError = detail.error ?? transform.error ?? original.error ?? transformed.error;
+
+	return (
+		<div className="flex flex-1 flex-col gap-4 px-5 pb-8">
+			<BackHeader title="내 이미지 검수" onBack={() => void navigate("/images/new")} />
+			{detail.isPending && <p role="status">이미지를 불러오는 중</p>}
+			{detail.data === null && <Alert>이미지가 없거나 이 계정의 이미지가 아닙니다.</Alert>}
+			{loadError && <Alert>{loadError.message}</Alert>}
+			{detail.data && !detail.error && (
+				<>
+					<p className="text-body text-mute">비공개 원본이 저장되었습니다. 다른 사용자에게 공개되지 않습니다.</p>
+					<h2 className="text-subtitle text-ink">원본</h2>
+					{original.data && !original.error && (
+						<BlobImage blob={original.data} alt="비공개 원본 이미지" sha256={detail.data.sha256} />
+					)}
+					{detail.data.reviewStatus !== "PENDING" && (
+						<p role="status" className="text-body text-mute">
+							{detail.data.reviewStatus === "APPROVED"
+								? `${detail.data.selectedVersion === "GRAYSCALE" ? "회색조 변환본" : "원본"}을 비공개 보관용으로 확정했습니다.`
+								: "검수에서 제외했습니다. 원본은 비공개로 보관됩니다."}
+						</p>
+					)}
+					<Button
+						variant="secondary"
+						disabled={review.isPending}
+						onClick={() => review.mutate({ approved: true, version: "ORIGINAL" })}
+					>
+						원본 확인하고 저장 확정
+					</Button>
+					{canTransform && (
+						<Button variant="secondary" onClick={() => createTransform.mutate()}>
+							{transform.data?.status === "FAILED" ? "무료 회색조 변환 다시 시도" : "무료 회색조로 변환"}
+						</Button>
+					)}
+					{isWorking && (
+						<p role="status">회색조로 변환하고 있습니다. 이 화면에 다시 들어오면 결과를 확인할 수 있습니다.</p>
+					)}
+					{transform.data?.status === "FAILED" && <Alert>변환에 실패했습니다. 원본은 보관되어 있습니다.</Alert>}
+					{transformed.data && !transformed.error && (
+						<>
+							<h2 className="text-subtitle text-ink">회색조 변환본</h2>
+							<BlobImage blob={transformed.data} alt="비공개 회색조 변환본" sha256={transform.data?.sha256} />
+							<Button
+								disabled={review.isPending}
+								onClick={() => review.mutate({ approved: true, version: "GRAYSCALE" })}
+							>
+								변환본 확인하고 저장 확정
+							</Button>
+						</>
+					)}
+					<Button
+						variant="outline"
+						disabled={review.isPending}
+						onClick={() => review.mutate({ approved: false, version: "ORIGINAL" })}
+					>
+						검수에서 제외
+					</Button>
+					{createTransform.error && <Alert>{createTransform.error.message}</Alert>}
+					{review.error && <Alert>{review.error.message}</Alert>}
+				</>
+			)}
+		</div>
+	);
+}
