+import { Link } from "react-router";
+
+import type { PostDetail } from "@/shared/api/posts";
+import { postVerdictPath } from "@/shared/constants/routes";
+import { VERDICT_LABELS } from "@/shared/domain/verdict";
+import { formatRemaining } from "@/shared/utils/date";
+import { formatAmount } from "@/shared/utils/format";
+
+type PostFeedItemProps = { post: PostDetail; roomId: string };
+
+export function PostFeedItem({ post, roomId }: PostFeedItemProps) {
+	return (
+		<Link to={postVerdictPath(post.id, roomId)} className="flex flex-col gap-2 rounded-card bg-card p-4 shadow-card">
+			<p className="text-chip text-mute">
+				{post.postType === "spent" ? "썼어요" : "살까요?"}, {post.category}
+			</p>
+			<h2 className="text-subtitle text-ink">{post.item}</h2>
+			<p className="text-body text-ink">{formatAmount(post.amountKrw)}원</p>
+			<p className="text-chip text-mute">
+				{post.juryStatus
+					? `${VERDICT_LABELS[post.juryStatus]} 판결 보기`
+					: post.myVote
+						? "투표 완료, 판결 기다리는 중"
+						: post.canVote
+							? "배심원 투표하기"
+							: "배심원 투표를 기다리는 중"}
+			</p>
+			{!post.juryStatus && <p className="text-chip text-mute">{formatRemaining(post.voteDeadlineAt)}</p>}
+		</Link>
+	);
+}
