@@ -0,0 +1,53 @@
+import { useState } from "react";
+
+import type { PostDetail } from "@/shared/api/posts";
+import { VERDICT_LABELS, VOTE_VERDICTS } from "@/shared/domain/verdict";
+import { Alert } from "@/shared/ui/Alert";
+import { Button } from "@/shared/ui/Button";
+import { TextField } from "@/shared/ui/TextField";
+
+import { useCreatePostVote } from "../hooks/usePostActions";
+import { VerdictChoice, type VoteSide } from "./VerdictChoice";
+
+const REASON_MAX_LENGTH = 500;
+
+type PostVoteFormProps = { post: PostDetail; roomId: string };
+
+export function PostVoteForm({ post, roomId }: PostVoteFormProps) {
+	const [side, setSide] = useState<VoteSide>("oppose");
+	const [reason, setReason] = useState("");
+	const vote = useCreatePostVote(post.id);
+	const verdict = VOTE_VERDICTS[post.postType][side];
+	const canSubmit = reason.trim().length > 0 && roomId !== "" && !vote.isPending;
+
+	if (post.myVote || vote.isSuccess) {
+		return (
+			<p role="status" className="text-body text-mute">
+				투표를 제출했습니다. 나머지 배심원을 기다려 주세요.
+			</p>
+		);
+	}
+	if (!post.canVote) {
+		return null;
+	}
+
+	return (
+		<section className="flex flex-col gap-3" aria-label="배심원 투표">
+			<h2 className="text-subtitle text-ink">배심원 투표</h2>
+			<VerdictChoice postType={post.postType} value={side} onChange={setSide} />
+			<TextField
+				label="투표 사유"
+				value={reason}
+				onChange={setReason}
+				maxLength={REASON_MAX_LENGTH}
+				required
+				multiline
+			/>
+			<p className="text-chip text-mute">제출한 표는 수정할 수 없습니다. 전원이 투표하면 자동으로 판결합니다.</p>
+			{vote.error && <Alert>{vote.error.message}</Alert>}
+			<Button disabled={!canSubmit} onClick={() => vote.mutate({ verdict, reason: reason.trim(), roomId })}>
+				{vote.isPending ? "제출 중" : `${VERDICT_LABELS[verdict]}로 평결 제출`}
+			</Button>
+		</section>
+	);
+}
