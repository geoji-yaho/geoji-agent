diff --git a/src/features/post/pages/PostCardPage.tsx b/src/features/post/pages/PostCardPage.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..03c4eec950fb38af33f443a66dc71279099f7129
--- /dev/null
+++ b/src/features/post/pages/PostCardPage.tsx
@@ -0,0 +1,95 @@
+import { useQuery } from "@tanstack/react-query";
+import { useNavigate, useParams, useSearchParams } from "react-router";
+
+import { postQueries } from "@/shared/api/posts";
+import { BackHeader } from "@/shared/components/BackHeader";
+import { postVerdictPath } from "@/shared/constants/routes";
+import { Alert } from "@/shared/ui/Alert";
+import { BlobImage } from "@/shared/ui/BlobImage";
+import { Button } from "@/shared/ui/Button";
+
+import { useDownloadCard } from "../hooks/useDownloadCard";
+import { useCreateCardRender } from "../hooks/usePostActions";
+
+const ACCESS_RECHECK_MS = 5000;
+const STATUS_LABELS = {
+	PENDING: "카드 제작을 기다리고 있습니다.",
+	RENDERING: "카드를 만들고 있습니다.",
+	READY: "저장된 카드입니다.",
+	FAILED: "카드를 만들지 못했습니다. 판결문은 그대로 보관됩니다."
+} as const;
+
+export function PostCardPage() {
+	const { postId = "" } = useParams();
+	const [params] = useSearchParams();
+	const roomId = params.get("room") ?? "";
+	const navigate = useNavigate();
+	const card = useQuery({ ...postQueries.shareCard(postId), refetchInterval: ACCESS_RECHECK_MS });
+	const render = useQuery({ ...postQueries.cardRender(postId), enabled: Boolean(card.data) });
+	const createRender = useCreateCardRender(postId);
+	const download = useDownloadCard(postId);
+	const isAvailable = Boolean(card.data) && !card.error && !render.error;
+	const isReady = isAvailable && render.data?.status === "READY";
+	const png = useQuery({ ...postQueries.cardPng(postId, render.data?.pngSha256 ?? null), enabled: isReady });
+	const isWorking = render.data?.status === "PENDING" || render.data?.status === "RENDERING";
+	const canCreate = isAvailable && !isWorking && !isReady && !createRender.isPending;
+	const loadError = card.error ?? render.error;
+	const hasDeniedDownload = download.error?.kind === "notFound" || download.error?.kind === "forbidden";
+
+	return (
+		<div className="flex flex-1 flex-col gap-4 px-5 pb-8">
+			<BackHeader title="판결 카드" onBack={() => void navigate(postVerdictPath(postId, roomId))} />
+			{card.isPending && <p role="status">공개할 판결 문구를 불러오는 중</p>}
+			{loadError && <Alert>{loadError.message}</Alert>}
+			{card.data === null && <Alert>아직 판결이 확정되지 않았거나 삭제 또는 공유 철회로 카드를 볼 수 없습니다.</Alert>}
+			{isAvailable && card.data && (
+				<>
+					{render.data && (
+						<p role="status" className="text-body text-mute">
+							{STATUS_LABELS[render.data.status]}
+						</p>
+					)}
+					{isReady && !hasDeniedDownload ? (
+						<>
+							{png.isPending && <p role="status">저장된 이미지를 불러오는 중</p>}
+							{png.error && <Alert>{png.error.message}</Alert>}
+							{png.data && !png.error && (
+								<BlobImage blob={png.data} alt="서버에 저장된 판결 카드" sha256={render.data?.pngSha256 ?? null} />
+							)}
+							<Button
+								onClick={() => download.mutate()}
+								disabled={!png.data || Boolean(png.error) || download.isPending}
+							>
+								{download.isPending ? "다운로드 중" : "PNG 다운로드"}
+							</Button>
+						</>
+					) : (
+						<section className="flex flex-col gap-3 border-y border-line py-4" aria-label="카드에 공개되는 문구">
+							<h1 className="text-title text-ink">{card.data.headline}</h1>
+							{card.data.statement.map((line, index) => (
+								<p key={index} className="text-body text-text">
+									{line}
+								</p>
+							))}
+							{card.data.sentenceLabel && <p className="text-body text-ink">{card.data.sentenceLabel}</p>}
+							<p className="text-chip text-mute">개인 지출 내역과 비공개 근거는 카드에 담지 않습니다.</p>
+						</section>
+					)}
+					{canCreate && (
+						<Button onClick={() => createRender.mutate(render.data?.status === "FAILED")}>
+							{render.data?.status === "FAILED" ? "카드만 다시 만들기" : "카드 PNG 만들고 서버에 저장"}
+						</Button>
+					)}
+					{createRender.error && (
+						<Alert>
+							{createRender.error.kind === "notFound"
+								? "현재 카드를 만들 수 없습니다. 판결 화면에서 게시물과 공유 설정을 확인해 주세요."
+								: createRender.error.message}
+						</Alert>
+					)}
+					{download.error && <Alert>{download.error.message}</Alert>}
+				</>
+			)}
+		</div>
+	);
+}
