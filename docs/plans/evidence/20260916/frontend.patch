--- /dev/null
+++ b/src/features/post/components/PostMemeImage.tsx
@@ -0,0 +1,37 @@
+import { useQuery } from "@tanstack/react-query";
+import { useState } from "react";
+
+import { type PostMeme, postQueries } from "@/shared/api/posts";
+import { Alert } from "@/shared/ui/Alert";
+import { BlobImage } from "@/shared/ui/BlobImage";
+
+type PostMemeImageProps = { meme: PostMeme | null };
+
+export function PostMemeImage({ meme }: PostMemeImageProps) {
+	const [isFailed, setIsFailed] = useState(false);
+	const isProtected = Boolean(meme?.imageUrl?.startsWith("/api/memes/") && meme.imageId);
+	const image = useQuery({ ...postQueries.meme(meme?.imageId ?? ""), enabled: isProtected });
+	if (!meme?.imageUrl) {
+		return <p className="text-chip text-mute">이 판결에 맞는 등록된 짤이 없습니다.</p>;
+	}
+	if (isProtected) {
+		return (
+			<>
+				{image.isPending && <p role="status">짤을 불러오는 중</p>}
+				{image.error && <Alert>짤을 불러오지 못했습니다.</Alert>}
+				{image.data && !image.error && <BlobImage blob={image.data} alt="판결에 선택된 짤" />}
+			</>
+		);
+	}
+	if (isFailed) {
+		return <p className="text-chip text-mute">짤을 불러오지 못했습니다.</p>;
+	}
+	return (
+		<img
+			src={meme.imageUrl}
+			alt="판결에 선택된 짤"
+			className="w-full rounded-card object-contain"
+			onError={() => setIsFailed(true)}
+		/>
+	);
+}
