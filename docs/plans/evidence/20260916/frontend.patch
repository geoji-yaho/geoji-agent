+import { useMutation } from "@tanstack/react-query";
+
+import { completePost, type CompletePostInput, submitPost } from "@/shared/api/posts";
+
+export function useSubmitPost() {
+	return useMutation({ mutationFn: submitPost });
+}
+
+export function useCompletePost() {
+	return useMutation({
+		mutationFn: ({ submissionId, input }: { submissionId: string; input: CompletePostInput }) =>
+			completePost(submissionId, input)
+	});
+}
