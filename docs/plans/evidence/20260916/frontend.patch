diff --git a/src/features/images/api/images.ts b/src/features/images/api/images.ts
new file mode 100644
index 0000000000000000000000000000000000000000..63fcae74aa8698d849eb2046951180a89dbfe4fb
--- /dev/null
+++ b/src/features/images/api/images.ts
@@ -0,0 +1,150 @@
+import { queryOptions } from "@tanstack/react-query";
+
+import { isApiError } from "@/shared/api/api-error";
+import { http } from "@/shared/api/http";
+
+export type PrivateImage = {
+	id: string;
+	sha256: string;
+	mimeType: string;
+	width: number;
+	height: number;
+	status: "PRIVATE";
+	reviewStatus: "PENDING" | "APPROVED" | "REJECTED";
+	selectedVersion: "ORIGINAL" | "GRAYSCALE" | null;
+	contentUrl: string;
+};
+
+export type ImageTransform = {
+	id: string;
+	imageId: string;
+	status: "PENDING" | "RENDERING" | "READY" | "FAILED";
+	operation: "GRAYSCALE";
+	sha256: string | null;
+	contentUrl: string | null;
+	errorCode: string | null;
+};
+
+export type CatalogMeme = {
+	id: string;
+	imageId: string;
+	selectedVersion: "ORIGINAL" | "GRAYSCALE";
+	tag: string;
+	approved: boolean;
+	active: boolean;
+	imageUrl: string;
+};
+
+export const MEME_TAGS = ["GUILTY_HEAVY", "GUILTY_LIGHT", "NOT_GUILTY", "APPROVED", "REJECTED"] as const;
+const POLL_INTERVAL_MS = 1000;
+
+function imagePath(imageId: string) {
+	return `/api/images/${encodeURIComponent(imageId)}`;
+}
+
+async function fetchOptional<T>(path: string, signal: AbortSignal) {
+	try {
+		return await http.get<T>(path, { signal });
+	} catch (error) {
+		if (isApiError(error) && error.kind === "notFound") {
+			return null;
+		}
+		throw error;
+	}
+}
+
+export function uploadPrivateImage(file: File) {
+	const body = new FormData();
+	body.set("file", file);
+	return http.post<PrivateImage>("/api/images", { body });
+}
+
+export function reviewPrivateImage(imageId: string, input: { approved: boolean; version: "ORIGINAL" | "GRAYSCALE" }) {
+	return http.post<PrivateImage>(`${imagePath(imageId)}/review`, { body: input });
+}
+
+export function createImageTransform(imageId: string) {
+	return http.post<ImageTransform>(`${imagePath(imageId)}/transform`, { body: { operation: "GRAYSCALE" } });
+}
+
+export function createCatalogTransform(memeId: string) {
+	return http.post<ImageTransform>(`/api/admin/memes/${encodeURIComponent(memeId)}/transform`, {
+		body: { operation: "GRAYSCALE" }
+	});
+}
+
+export function updateCatalogMemeVersion(memeId: string, version: "ORIGINAL" | "GRAYSCALE") {
+	return http.put<CatalogMeme>(`/api/admin/memes/${encodeURIComponent(memeId)}/image-version`, { body: { version } });
+}
+
+export function uploadCatalogMeme(input: {
+	file: File;
+	tag: string;
+	strategies: string;
+	emotions: string;
+	keywords: string;
+}) {
+	const body = new FormData();
+	body.set("file", input.file);
+	body.set("tag", input.tag);
+	body.set("strategies", input.strategies);
+	body.set("emotions", input.emotions);
+	body.set("keywords", input.keywords);
+	return http.post<CatalogMeme>("/api/admin/memes", { body });
+}
+
+export function reviewCatalogMeme(id: string, approved: boolean) {
+	return http.post<CatalogMeme>(`/api/admin/memes/${encodeURIComponent(id)}/review`, { body: { approved } });
+}
+
+export function updateCatalogMemeActive(id: string, active: boolean) {
+	return http.put<CatalogMeme>(`/api/admin/memes/${encodeURIComponent(id)}/active`, { body: { active } });
+}
+
+export const imageQueries = {
+	all: () => ["images"] as const,
+	detail: (imageId: string) =>
+		queryOptions({
+			queryKey: [...imageQueries.all(), "detail", imageId] as const,
+			queryFn: ({ signal }) => fetchOptional<PrivateImage>(imagePath(imageId), signal)
+		}),
+	content: (imageId: string, transformed: boolean, sha256: string | null) =>
+		queryOptions({
+			queryKey: [...imageQueries.all(), "content", imageId, transformed, sha256] as const,
+			queryFn: ({ signal }) =>
+				http.getBlob(`${imagePath(imageId)}${transformed ? "/transform" : ""}/content`, { signal }),
+			staleTime: 0,
+			gcTime: 0
+		}),
+	transform: (imageId: string) =>
+		queryOptions({
+			queryKey: [...imageQueries.all(), "transform", imageId] as const,
+			queryFn: ({ signal }) => fetchOptional<ImageTransform>(`${imagePath(imageId)}/transform`, signal),
+			refetchInterval: (query) => {
+				const status = query.state.data?.status;
+				return status === "PENDING" || status === "RENDERING" ? POLL_INTERVAL_MS : false;
+			}
+		}),
+	catalogContent: (memeId: string, version: string) =>
+		queryOptions({
+			queryKey: [...imageQueries.all(), "catalog-content", memeId, version] as const,
+			queryFn: ({ signal }) => http.getBlob(`/api/admin/memes/${encodeURIComponent(memeId)}/image`, { signal }),
+			staleTime: 0,
+			gcTime: 0
+		}),
+	catalogTransform: (memeId: string) =>
+		queryOptions({
+			queryKey: [...imageQueries.all(), "catalog-transform", memeId] as const,
+			queryFn: ({ signal }) =>
+				fetchOptional<ImageTransform>(`/api/admin/memes/${encodeURIComponent(memeId)}/transform`, signal),
+			refetchInterval: (query) => {
+				const status = query.state.data?.status;
+				return status === "PENDING" || status === "RENDERING" ? POLL_INTERVAL_MS : false;
+			}
+		}),
+	catalog: () =>
+		queryOptions({
+			queryKey: [...imageQueries.all(), "catalog"] as const,
+			queryFn: ({ signal }) => http.get<CatalogMeme[]>("/api/admin/memes", { signal })
+		})
+};
diff --git a/src/features/images/components/CatalogMemeItem.tsx b/src/features/images/components/CatalogMemeItem.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..7871d79e6f6ee6ed89f85e688c9d45c045d98f7e
--- /dev/null
+++ b/src/features/images/components/CatalogMemeItem.tsx
@@ -0,0 +1,69 @@
+import { useQuery } from "@tanstack/react-query";
+
+import { Alert } from "@/shared/ui/Alert";
+import { BlobImage } from "@/shared/ui/BlobImage";
+import { Button } from "@/shared/ui/Button";
+
+import { type CatalogMeme, imageQueries } from "../api/images";
+import {
+	useCreateCatalogTransform,
+	useReviewCatalogMeme,
+	useUpdateCatalogMemeActive,
+	useUpdateCatalogMemeVersion
+} from "../hooks/useImageActions";
+
+type CatalogMemeItemProps = { meme: CatalogMeme };
+
+export function CatalogMemeItem({ meme }: CatalogMemeItemProps) {
+	const image = useQuery(imageQueries.catalogContent(meme.id, meme.selectedVersion));
+	const transform = useQuery(imageQueries.catalogTransform(meme.id));
+	const createTransform = useCreateCatalogTransform(meme.id);
+	const version = useUpdateCatalogMemeVersion(meme.id);
+	const review = useReviewCatalogMeme();
+	const updateActive = useUpdateCatalogMemeActive();
+	const isWorking = transform.data?.status === "PENDING" || transform.data?.status === "RENDERING";
+	const isUpdating = review.isPending || updateActive.isPending || version.isPending;
+	const error =
+		image.error ?? transform.error ?? createTransform.error ?? version.error ?? review.error ?? updateActive.error;
+
+	return (
+		<article className="flex flex-col gap-2 border-t border-line pt-4">
+			<h3 className="text-body text-ink">{meme.tag}</h3>
+			{image.data && !image.error && <BlobImage blob={image.data} alt={`${meme.tag} 검수 이미지`} />}
+			<p className="text-chip text-mute">
+				{meme.selectedVersion === "GRAYSCALE" ? "회색조 변환본" : "원본"}, 검수 {meme.approved ? "승인" : "대기"}, 판결
+				선택 {meme.active ? "활성" : "비활성"}
+			</p>
+			{isWorking ? (
+				<p role="status">회색조 변환 중</p>
+			) : transform.data?.status === "READY" ? (
+				<Button
+					variant="secondary"
+					disabled={isUpdating}
+					onClick={() => version.mutate(meme.selectedVersion === "GRAYSCALE" ? "ORIGINAL" : "GRAYSCALE")}
+				>
+					{meme.selectedVersion === "GRAYSCALE" ? "원본 선택하고 다시 검수" : "회색조 선택하고 다시 검수"}
+				</Button>
+			) : (
+				<Button variant="secondary" disabled={createTransform.isPending} onClick={() => createTransform.mutate()}>
+					{transform.data?.status === "FAILED" ? "무료 회색조 변환 재시도" : "무료 회색조로 변환"}
+				</Button>
+			)}
+			<Button
+				variant="secondary"
+				disabled={isUpdating}
+				onClick={() => review.mutate({ id: meme.id, approved: !meme.approved })}
+			>
+				{meme.approved ? "승인 철회" : "검수 승인"}
+			</Button>
+			<Button
+				variant="outline"
+				disabled={isUpdating || !meme.approved}
+				onClick={() => updateActive.mutate({ id: meme.id, active: !meme.active })}
+			>
+				{meme.active ? "선택 비활성화" : "선택 활성화"}
+			</Button>
+			{error && <Alert>{error.message}</Alert>}
+		</article>
+	);
+}
diff --git a/src/features/images/hooks/useImageActions.ts b/src/features/images/hooks/useImageActions.ts
new file mode 100644
index 0000000000000000000000000000000000000000..8834e1ecfcb75407ea214750f9cf6a59d347f53d
--- /dev/null
+++ b/src/features/images/hooks/useImageActions.ts
@@ -0,0 +1,77 @@
+import { useMutation, useQueryClient } from "@tanstack/react-query";
+
+import {
+	createCatalogTransform,
+	createImageTransform,
+	imageQueries,
+	reviewCatalogMeme,
+	reviewPrivateImage,
+	updateCatalogMemeActive,
+	updateCatalogMemeVersion,
+	uploadCatalogMeme,
+	uploadPrivateImage
+} from "../api/images";
+
+export function useUploadPrivateImage() {
+	const queryClient = useQueryClient();
+	return useMutation({
+		mutationFn: uploadPrivateImage,
+		onSuccess: (data) => queryClient.setQueryData(imageQueries.detail(data.id).queryKey, data)
+	});
+}
+
+export function useCreateImageTransform(imageId: string) {
+	const queryClient = useQueryClient();
+	return useMutation({
+		mutationFn: () => createImageTransform(imageId),
+		onSuccess: (data) => queryClient.setQueryData(imageQueries.transform(imageId).queryKey, data)
+	});
+}
+
+export function useUploadCatalogMeme() {
+	const queryClient = useQueryClient();
+	return useMutation({
+		mutationFn: uploadCatalogMeme,
+		onSuccess: () => queryClient.invalidateQueries({ queryKey: imageQueries.catalog().queryKey })
+	});
+}
+
+export function useReviewCatalogMeme() {
+	const queryClient = useQueryClient();
+	return useMutation({
+		mutationFn: ({ id, approved }: { id: string; approved: boolean }) => reviewCatalogMeme(id, approved),
+		onSuccess: () => queryClient.invalidateQueries({ queryKey: imageQueries.catalog().queryKey })
+	});
+}
+
+export function useUpdateCatalogMemeActive() {
+	const queryClient = useQueryClient();
+	return useMutation({
+		mutationFn: ({ id, active }: { id: string; active: boolean }) => updateCatalogMemeActive(id, active),
+		onSuccess: () => queryClient.invalidateQueries({ queryKey: imageQueries.catalog().queryKey })
+	});
+}
+
+export function useReviewPrivateImage(imageId: string) {
+	const queryClient = useQueryClient();
+	return useMutation({
+		mutationFn: (input: { approved: boolean; version: "ORIGINAL" | "GRAYSCALE" }) => reviewPrivateImage(imageId, input),
+		onSuccess: (data) => queryClient.setQueryData(imageQueries.detail(imageId).queryKey, data)
+	});
+}
+
+export function useCreateCatalogTransform(memeId: string) {
+	const queryClient = useQueryClient();
+	return useMutation({
+		mutationFn: () => createCatalogTransform(memeId),
+		onSuccess: (data) => queryClient.setQueryData(imageQueries.catalogTransform(memeId).queryKey, data)
+	});
+}
+
+export function useUpdateCatalogMemeVersion(memeId: string) {
+	const queryClient = useQueryClient();
+	return useMutation({
+		mutationFn: (version: "ORIGINAL" | "GRAYSCALE") => updateCatalogMemeVersion(memeId, version),
+		onSuccess: () => queryClient.invalidateQueries({ queryKey: imageQueries.catalog().queryKey })
+	});
+}
