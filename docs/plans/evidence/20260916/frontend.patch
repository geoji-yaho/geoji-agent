@@ -0,0 +1,137 @@
+import { useQuery } from "@tanstack/react-query";
+import { useState } from "react";
+import { useNavigate, useParams, useSearchParams } from "react-router";
+
+import { postQueries } from "@/shared/api/posts";
+import { profileQueries } from "@/shared/api/profile";
+import { BackHeader } from "@/shared/components/BackHeader";
+import { VerdictStamp } from "@/shared/components/VerdictStamp";
+import { postCardPath } from "@/shared/constants/routes";
+import { Alert } from "@/shared/ui/Alert";
+import { Button } from "@/shared/ui/Button";
+import { formatRemaining } from "@/shared/utils/date";
+import { formatAmount } from "@/shared/utils/format";
+
+import { PostMemeImage } from "../components/PostMemeImage";
+import { PostVoteForm } from "../components/PostVoteForm";
+import { useRemovePost, useUpdateCardSharing } from "../hooks/usePostActions";
+
+export function PostVerdictPage() {
+	const { postId = "" } = useParams();
+	const [searchParams] = useSearchParams();
+	const navigate = useNavigate();
+	const roomId = searchParams.get("room") ?? "";
+	const [pollStartedAt] = useState(() => Date.now());
+	const detail = useQuery(postQueries.detail(postId));
+	const verdict = useQuery(postQueries.verdict(postId, roomId, pollStartedAt));
+	const { refetch: reloadDetail } = detail;
+	const { refetch: reloadVerdict } = verdict;
+	const profile = useQuery(profileQueries.me());
+	const removePost = useRemovePost(postId);
+	const sharing = useUpdateCardSharing(postId);
+	const [isConfirmingDelete, setIsConfirmingDelete] = useState(false);
+	const post = detail.error ? null : detail.data;
+	const result = verdict.error ? null : verdict.data;
+	const view = detail.error ? null : result?.view;
+	const isUnavailable = detail.data === null || verdict.data === null || removePost.isSuccess;
+	const loadError = detail.error ?? verdict.error;
+	const isAuthor = Boolean(post && profile.data && profile.data.id === post.authorId);
+	const voteRoomId = roomId || post?.roomIds[0] || "";
+
+	return (
+		<div className="flex flex-1 flex-col gap-4 px-5 pb-8">
+			<BackHeader title="재판과 판결" onBack={() => void navigate("/")} />
+			{isUnavailable ? (
+				<Alert>삭제되었거나 공유가 철회된 게시물입니다. 이 계정으로 볼 수 없습니다.</Alert>
+			) : (
+				<>
+					{(detail.isPending || verdict.isPending) && <p role="status">재판을 불러오는 중</p>}
+					{loadError && (
+						<div className="flex flex-col gap-2">
+							<Alert>{loadError.message}</Alert>
+							<Button
+								variant="secondary"
+								onClick={() => {
+									void reloadDetail();
+									void reloadVerdict();
+								}}
+							>
+								다시 조회
+							</Button>
+						</div>
+					)}
+					{post && (
+						<section className="flex flex-col gap-2 border-b border-line pb-4">
+							<h1 className="text-title text-ink">{post.item}</h1>
+							<p className="text-body text-mute">
+								{post.category}, {formatAmount(post.amountKrw)}원
+							</p>
+							{post.reason && <p className="text-body text-text">{post.reason}</p>}
+							{!post.juryStatus && !result?.juryStatus && (
+								<p className="text-chip text-mute">투표 {formatRemaining(post.voteDeadlineAt)}</p>
+							)}
+						</section>
+					)}
+					{result && !result.juryStatus && (
+						<p role="status" className="text-body text-mute">
+							배심원의 투표를 기다리고 있습니다.
+						</p>
+					)}
+					{post && !result?.juryStatus && <PostVoteForm post={post} roomId={voteRoomId} />}
+					{result?.juryStatus && <VerdictStamp verdict={result.juryStatus} />}
+					{result?.juryStatus === "dismissed" && <p role="status">배심원이 충분히 모이지 않아 각하되었습니다.</p>}
+					{result?.juryStatus && result.juryStatus !== "dismissed" && !view && !loadError && (
+						<p role="status">판결문을 준비하고 있습니다. 잠시만 기다려 주세요.</p>
+					)}
+					{view && (
+						<section className="flex flex-col gap-3" aria-label="판결문">
+							<p className="text-chip text-mute">{view.source === "AI" ? "AI 판사의 판결문" : "기본 판결문"}</p>
+							<h2 className="text-title text-ink">{view.headline}</h2>
+							{view.statement.map((sentence, index) => (
+								<p key={index} className="text-body text-text">
+									{sentence}
+								</p>
+							))}
+							{view.sentenceLabel && <p className="text-subtitle text-ink">{view.sentenceLabel}</p>}
+							{view.source === "AI" && view.sentencingReason && (
+								<p className="text-body text-mute">{view.sentencingReason}</p>
+							)}
+							<PostMemeImage meme={view.meme} />
+							<Button onClick={() => void navigate(postCardPath(postId, voteRoomId))}>판결 카드 저장하기</Button>
+						</section>
+					)}
+					{isAuthor && (
+						<div className="flex flex-col gap-2 pt-4">
+							<Button variant="outline" disabled={sharing.isPending} onClick={() => sharing.mutate(false)}>
+								카드 공유 중지
+							</Button>
+							<Button variant="outline" disabled={sharing.isPending} onClick={() => sharing.mutate(true)}>
+								카드 공유 허용
+							</Button>
+							{sharing.data && (
+								<p role="status">{sharing.data.enabled ? "카드 공유를 허용했습니다." : "카드 공유를 중지했습니다."}</p>
+							)}
+							{sharing.error && <Alert>{sharing.error.message}</Alert>}
+							{isConfirmingDelete ? (
+								<>
+									<Alert>게시물과 판결 카드에 접근할 수 없게 됩니다. 삭제할까요?</Alert>
+									<Button variant="danger" disabled={removePost.isPending} onClick={() => removePost.mutate()}>
+										게시물 삭제 확인
+									</Button>
+									<Button variant="secondary" onClick={() => setIsConfirmingDelete(false)}>
+										취소
+									</Button>
+								</>
+							) : (
+								<Button variant="outline" onClick={() => setIsConfirmingDelete(true)}>
+									게시물 삭제
+								</Button>
+							)}
+							{removePost.error && <Alert>{removePost.error.message}</Alert>}
+						</div>
+					)}
+				</>
+			)}
+		</div>
+	);
+}
