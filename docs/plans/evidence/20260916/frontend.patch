+++ b/src/shared/ui/BlobImage.tsx
@@ -0,0 +1,21 @@
+import { useEffect, useRef } from "react";
+
+type BlobImageProps = { blob: Blob; alt: string; sha256?: string | null };
+
+export function BlobImage({ blob, alt, sha256 }: BlobImageProps) {
+	const imageRef = useRef<HTMLImageElement>(null);
+	useEffect(() => {
+		const url = URL.createObjectURL(blob);
+		const image = imageRef.current;
+		if (image) {
+			image.src = url;
+		}
+		return () => {
+			if (image) {
+				image.removeAttribute("src");
+			}
+			URL.revokeObjectURL(url);
+		};
+	}, [blob]);
+	return <img ref={imageRef} alt={alt} data-sha256={sha256} className="w-full rounded-card object-contain" />;
+}
