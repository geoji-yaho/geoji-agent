@@ -0,0 +1,89 @@
+import { useQuery } from "@tanstack/react-query";
+import { useState } from "react";
+import { useNavigate } from "react-router";
+
+import { BackHeader } from "@/shared/components/BackHeader";
+import { Alert } from "@/shared/ui/Alert";
+import { Button } from "@/shared/ui/Button";
+import { TextField } from "@/shared/ui/TextField";
+
+import { imageQueries, MEME_TAGS } from "../api/images";
+import { CatalogMemeItem } from "../components/CatalogMemeItem";
+import { useUploadCatalogMeme } from "../hooks/useImageActions";
+
+export function AdminImagesPage() {
+	const navigate = useNavigate();
+	const catalog = useQuery(imageQueries.catalog());
+	const upload = useUploadCatalogMeme();
+	const [file, setFile] = useState<File | null>(null);
+	const [tag, setTag] = useState<string>(MEME_TAGS[0]);
+	const [strategies, setStrategies] = useState("");
+	const [emotions, setEmotions] = useState("");
+	const [keywords, setKeywords] = useState("");
+	const mutationError = upload.error;
+
+	return (
+		<div className="flex flex-1 flex-col gap-4 px-5 pb-8">
+			<BackHeader title="관리자 짤 카탈로그" onBack={() => void navigate("/")} />
+			{catalog.isPending && <p role="status">관리 권한과 카탈로그를 확인하는 중</p>}
+			{catalog.error && (
+				<Alert>
+					{catalog.error.kind === "forbidden" ? "등록된 관리자만 접근할 수 있습니다." : catalog.error.message}
+				</Alert>
+			)}
+			{catalog.isSuccess && (
+				<>
+					<h1 className="text-title text-ink">짤 등록</h1>
+					<p className="text-body text-mute">
+						실제 판결과 일치하는 태그로 등록하세요. 검수 승인 후 선택 활성화를 켜면 판결에 사용됩니다.
+					</p>
+					<label className="flex flex-col gap-2 text-label text-ink">
+						이미지 파일
+						<input
+							type="file"
+							accept="image/png,image/jpeg,image/webp"
+							disabled={upload.isPending}
+							onChange={(event) => {
+								setFile(event.target.files?.[0] ?? null);
+								upload.reset();
+							}}
+							className="rounded-xl border border-line bg-card p-3 text-body"
+						/>
+					</label>
+					<label className="flex flex-col gap-2 text-label text-ink">
+						판결 태그
+						<select
+							value={tag}
+							onChange={(event) => setTag(event.target.value)}
+							className="rounded-xl border border-line bg-card p-3 text-body"
+						>
+							{MEME_TAGS.map((value) => (
+								<option key={value}>{value}</option>
+							))}
+						</select>
+					</label>
+					<TextField label="전략" hint="선택, 쉼표로 구분" value={strategies} onChange={setStrategies} />
+					<TextField label="감정" hint="선택, 쉼표로 구분" value={emotions} onChange={setEmotions} />
+					<TextField label="키워드" hint="선택, 쉼표로 구분" value={keywords} onChange={setKeywords} />
+					<Button
+						disabled={!file || upload.isPending}
+						onClick={() => {
+							if (file) {
+								upload.mutate({ file, tag, strategies, emotions, keywords });
+							}
+						}}
+					>
+						{upload.isPending ? "등록 중" : "검수 대기로 등록"}
+					</Button>
+					{mutationError && <Alert>{mutationError.message}</Alert>}
+					<section className="flex flex-col gap-4" aria-label="등록된 짤">
+						<h2 className="text-subtitle text-ink">등록된 짤 {catalog.data.length}개</h2>
+						{catalog.data.map((meme) => (
+							<CatalogMemeItem key={meme.id} meme={meme} />
+						))}
+					</section>
+				</>
+			)}
+		</div>
+	);
+}
