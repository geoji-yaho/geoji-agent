diff --git a/src/shared/api/posts.ts b/src/shared/api/posts.ts
new file mode 100644
index 0000000000000000000000000000000000000000..6dfab86f7183e4bb47770e64e158a2cd1ef460ad
--- /dev/null
+++ b/src/shared/api/posts.ts
@@ -0,0 +1,244 @@
+import { queryOptions } from "@tanstack/react-query";
+
+import type { PostType } from "../domain/post";
+import type { Verdict } from "../domain/verdict";
+import { isApiError } from "./api-error";
+import { http } from "./http";
+
+export type SubmitPostInput = {
+	postType: PostType;
+	amountKrw: number;
+	category: string;
+	item: string;
+	reason: string | null;
+	roomIds: string[];
+};
+
+export type Submission = {
+	submissionId: string;
+	status: "COMPLETED" | "NEEDS_INPUT" | "BLOCKED";
+	revision: string;
+	intakeResult: {
+		mode: "INITIAL" | "FINAL_CHECK";
+		message: string | null;
+		intakeSource: "AI" | "FALLBACK";
+		itemReview: { status: string; suggestedItem: string | null };
+		categoryReview: { status: string; suggestedCategory: string | null; confidence: number };
+	};
+	postId: string | null;
+};
+
+export type CompletePostInput = SubmitPostInput & {
+	action: "REVISE" | "PROCEED";
+	revision: string;
+};
+
+export type PostDetail = SubmitPostInput & {
+	id: string;
+	authorId: string;
+	voteDeadlineAt: string;
+	myVote: Verdict | null;
+	canVote: boolean;
+	juryStatus: Verdict | null;
+	textStatus: "PENDING" | "GENERATING" | "TEMPLATE_READY" | "AI_READY";
+};
+
+export type PostMeme = { tag: string; imageId: string | null; imageUrl: string | null };
+
+export type PostVerdict = {
+	schemaVersion: number;
+	postId: string;
+	juryStatus: Verdict | null;
+	sentenceStatus: "PENDING" | "FINAL";
+	textStatus: "PENDING" | "GENERATING" | "TEMPLATE_READY" | "AI_READY";
+	textVersion: number;
+	view: {
+		intensity: string;
+		headline: string;
+		statement: string[];
+		sentence: string | null;
+		sentenceLabel: string | null;
+		sentencingReason: string | null;
+		source: "AI" | "TEMPLATE";
+		meme: PostMeme | null;
+	} | null;
+	pollAfterMs: number;
+};
+
+export type PublicShareCard = {
+	postId: string;
+	postType: PostType;
+	juryStatus: Verdict;
+	intensity: string;
+	headline: string;
+	statement: string[];
+	sentence: string | null;
+	sentenceLabel: string | null;
+	meme: PostMeme | null;
+};
+
+export type CardRender = {
+	id: string;
+	postId: string;
+	status: "PENDING" | "RENDERING" | "READY" | "FAILED";
+	inputHash: string;
+	pngSha256: string | null;
+	pngUrl: string | null;
+	downloadUrl: string | null;
+	errorCode: string | null;
+};
+
+export type PostVoteInput = { verdict: Exclude<Verdict, "dismissed">; reason: string; roomId: string };
+
+const CARD_POLL_MS = 1000;
+const SLOW_POLL_MS = 5000;
+const FAST_POLL_DURATION_MS = 15_000;
+
+function getLatestVerdict(previous: unknown, next: unknown) {
+	const hasVersions = typeof previous === "object" && previous !== null && typeof next === "object" && next !== null;
+	if (
+		hasVersions &&
+		"textVersion" in previous &&
+		"textVersion" in next &&
+		typeof previous.textVersion === "number" &&
+		typeof next.textVersion === "number"
+	) {
+		return previous.textVersion > next.textVersion ? previous : next;
+	}
+	return next;
+}
+
+function postPath(postId: string) {
+	return `/api/posts/${encodeURIComponent(postId)}`;
+}
+
+async function fetchOptional<T>(path: string, signal: AbortSignal) {
+	try {
+		return await http.get<T>(path, { signal });
+	} catch (error) {
+		if (isApiError(error) && error.kind === "notFound") {
+			return null;
+		}
+		throw error;
+	}
+}
+
+export function submitPost(request: { input: SubmitPostInput; idempotencyKey: string }) {
+	return http.post<Submission>("/api/post-submissions", {
+		body: request.input,
+		idempotencyKey: request.idempotencyKey
+	});
+}
+
+export function completePost(submissionId: string, input: CompletePostInput) {
+	return http.post<Submission>(`/api/post-submissions/${encodeURIComponent(submissionId)}/complete`, { body: input });
+}
+
+export function castPostVote(postId: string, input: PostVoteInput) {
+	return http.post<{ id: string; postId: string }>(`${postPath(postId)}/votes`, { body: input });
+}
+
+export function createCardRender(postId: string, retry: boolean) {
+	return http.post<CardRender>(`${postPath(postId)}/share-card/render${retry ? "/retry" : ""}`);
+}
+
+export function updateCardSharing(postId: string, enabled: boolean) {
+	return http.put<{ enabled: boolean }>(`${postPath(postId)}/share-card/sharing`, { body: { enabled } });
+}
+
+export function removePost(postId: string) {
+	return http.delete<void>(postPath(postId));
+}
+
+export function fetchCardDownload(postId: string) {
+	return http.getBlob(`${postPath(postId)}/share-card/download`);
+}
+
+export function fetchCardPng(postId: string, signal?: AbortSignal) {
+	return http.getBlob(`${postPath(postId)}/share-card/png`, { signal });
+}
+
+export const postQueries = {
+	all: () => ["posts"] as const,
+	meme: (imageId: string) =>
+		queryOptions({
+			queryKey: [...postQueries.all(), "meme", imageId] as const,
+			queryFn: ({ signal }) => http.getBlob(`/api/memes/${encodeURIComponent(imageId)}/image`, { signal }),
+			staleTime: 0,
+			gcTime: 0
+		}),
+	listByRoom: (roomId: string) =>
+		queryOptions({
+			queryKey: [...postQueries.all(), "room", roomId] as const,
+			queryFn: ({ signal }) =>
+				http.get<PostDetail[]>(`/api/rooms/${encodeURIComponent(roomId)}/posts`, { query: { limit: 50 }, signal }),
+			refetchInterval: SLOW_POLL_MS
+		}),
+	detailKey: (postId: string) => [...postQueries.all(), "detail", postId] as const,
+	detail: (postId: string) =>
+		queryOptions({
+			queryKey: postQueries.detailKey(postId),
+			queryFn: ({ signal }) => fetchOptional<PostDetail>(postPath(postId), signal),
+			refetchInterval: (query) => (query.state.data === null || query.state.status === "error" ? false : SLOW_POLL_MS)
+		}),
+	verdictKey: (postId: string) => [...postQueries.all(), "verdict", postId] as const,
+	verdict: (postId: string, roomId: string, startedAt: number) =>
+		queryOptions({
+			queryKey: [...postQueries.verdictKey(postId), roomId] as const,
+			structuralSharing: getLatestVerdict,
+			queryFn: async ({ signal }) => {
+				try {
+					return await http.get<PostVerdict>(`${postPath(postId)}/verdict`, {
+						query: { room_id: roomId || null },
+						signal
+					});
+				} catch (error) {
+					if (isApiError(error) && error.kind === "notFound") {
+						return null;
+					}
+					throw error;
+				}
+			},
+			refetchInterval: (query) => {
+				const data = query.state.data;
+				if (query.state.status === "error" || data === null) {
+					return false;
+				}
+				if (data?.juryStatus === "dismissed") {
+					return false;
+				}
+				if (data?.textStatus === "AI_READY" || data?.textStatus === "TEMPLATE_READY") {
+					return SLOW_POLL_MS;
+				}
+				const pollMs = data?.pollAfterMs ?? CARD_POLL_MS;
+				return Date.now() - startedAt >= FAST_POLL_DURATION_MS ? Math.max(pollMs, SLOW_POLL_MS) : pollMs;
+			}
+		}),
+	shareCard: (postId: string) =>
+		queryOptions({
+			queryKey: [...postQueries.all(), "share-card", postId] as const,
+			queryFn: ({ signal }) => fetchOptional<PublicShareCard>(`${postPath(postId)}/share-card`, signal)
+		}),
+	cardRender: (postId: string) =>
+		queryOptions({
+			queryKey: [...postQueries.all(), "card-render", postId] as const,
+			queryFn: ({ signal }) => fetchOptional<CardRender>(`${postPath(postId)}/share-card/render`, signal),
+			refetchInterval: (query) => {
+				if (query.state.status === "error") {
+					return false;
+				}
+				const status = query.state.data?.status;
+				if (status === "READY") {
+					return SLOW_POLL_MS;
+				}
+				return status === "PENDING" || status === "RENDERING" ? CARD_POLL_MS : false;
+			}
+		}),
+	cardPng: (postId: string, pngSha256: string | null) =>
+		queryOptions({
+			queryKey: [...postQueries.all(), "card-png", postId, pngSha256] as const,
+			queryFn: ({ signal }) => fetchCardPng(postId, signal),
+			staleTime: 0,
+			gcTime: 0
+		})
+};
