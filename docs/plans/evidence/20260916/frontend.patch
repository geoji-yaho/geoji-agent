--- /dev/null
+++ b/src/features/post/hooks/useDownloadCard.ts
@@ -0,0 +1,21 @@
+import { useMutation } from "@tanstack/react-query";
+
+import { fetchCardDownload } from "@/shared/api/posts";
+
+const URL_RELEASE_MS = 1000;
+
+export function useDownloadCard(postId: string) {
+	return useMutation({
+		mutationFn: () => fetchCardDownload(postId),
+		onSuccess: (blob) => {
+			const url = URL.createObjectURL(blob);
+			const anchor = document.createElement("a");
+			anchor.href = url;
+			anchor.download = `geoji-verdict-${postId}.png`;
+			document.body.append(anchor);
+			anchor.click();
+			anchor.remove();
+			setTimeout(() => URL.revokeObjectURL(url), URL_RELEASE_MS);
+		}
+	});
+}
diff --git a/src/features/post/hooks/usePostActions.ts b/src/features/post/hooks/usePostActions.ts
new file mode 100644
index 0000000000000000000000000000000000000000..5b9c47be4ccc101057f01e60c5788dd0d211c628
--- /dev/null
+++ b/src/features/post/hooks/usePostActions.ts
@@ -0,0 +1,49 @@
+import { useMutation, useQueryClient } from "@tanstack/react-query";
+
+import {
+	castPostVote,
+	createCardRender,
+	postQueries,
+	type PostVoteInput,
+	removePost,
+	updateCardSharing
+} from "@/shared/api/posts";
+
+export function useCreatePostVote(postId: string) {
+	const queryClient = useQueryClient();
+	return useMutation({
+		mutationFn: (input: PostVoteInput) => castPostVote(postId, input),
+		onSettled: () =>
+			Promise.all([
+				queryClient.invalidateQueries({ queryKey: postQueries.detailKey(postId) }),
+				queryClient.invalidateQueries({ queryKey: postQueries.verdictKey(postId) })
+			])
+	});
+}
+
+export function useCreateCardRender(postId: string) {
+	const queryClient = useQueryClient();
+	return useMutation({
+		mutationFn: (retry: boolean) => createCardRender(postId, retry),
+		onSuccess: (data) => queryClient.setQueryData(postQueries.cardRender(postId).queryKey, data)
+	});
+}
+
+export function useRemovePost(postId: string) {
+	const queryClient = useQueryClient();
+	return useMutation({
+		mutationFn: () => removePost(postId),
+		onSuccess: () => {
+			queryClient.removeQueries({ queryKey: postQueries.all() });
+			queryClient.setQueryData(postQueries.detail(postId).queryKey, null);
+		}
+	});
+}
+
+export function useUpdateCardSharing(postId: string) {
+	const queryClient = useQueryClient();
+	return useMutation({
+		mutationFn: (enabled: boolean) => updateCardSharing(postId, enabled),
+		onSuccess: () => queryClient.invalidateQueries({ queryKey: postQueries.all() })
+	});
+}
