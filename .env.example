# 복사해서 .env 로 저장하고 값을 채운다. .env 는 커밋하지 않는다.
# 01 §3.7 설정 표의 키 이름 전부. 값이 비어 있으면 코드의 기본값을 쓴다.
# 기본값과 설명은 README 의 설정 표에 있다.

# 실행 환경 (development | production)
APP_ENV=

# 비밀값 · 외부 주소 — 로그와 git 에 남기지 않는다
DATABASE_URL=
BACKEND_INTERNAL_URL=
SERVICE_AUTH_TOKEN=
OPENAI_API_KEY=
XAI_API_KEY=
XAI_BASE_URL=

# 모델 — 서기·드립에 추론 모델(grok-4.6 · 4.5 · 4.3)을 넣으면 기동이 막힌다
MODEL_JUDGMENT=
MODEL_WRITER=
MODEL_EVALUATOR_HELL=

# 프롬프트 · 정책 버전
PROMPT_BUNDLE_VERSION=
# production 에서는 반드시 적는다(guardrail-v2). 안 적으면 기동 실패
GUARDRAIL_POLICY_VERSION=

# 시간 예산 (초)
INTAKE_TIMEOUT_SECONDS=
FIRST_RESULT_TARGET_SECONDS=
REPAIR_PATH_BUDGET_SECONDS=
SENTENCING_NODE_TIMEOUT_SECONDS=
WRITER_NODE_TIMEOUT_SECONDS=
EVALUATOR_NODE_TIMEOUT_SECONDS=

# 큐 · 워커
WORKER_POLL_MS=
JOB_LEASE_SECONDS=
HEARTBEAT_SECONDS=
WORKER_SLOTS=
WORKER_SHUTDOWN_DEADLINE_SECONDS=
REAPER_INTERVAL_SECONDS=
# 통합 테스트 전용. 설정 필드가 아니라 pytest 만 읽는다(02 §3.6).
# 값은 .env 가 아니라 환경변수로 준다.
# TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/postgres

# 마감 · 재시도
FINALIZE_RESERVE_MS=
INLINE_CONTEXT_MIN_REMAINING_MS=
IMMEDIATE_REPAIR_MAX=
TEXT_RETRY_ROUNDS=
TEXT_RETRY_TIMEOUT_SECONDS=

# 기억 · 증거
RECALL_CANDIDATE_LIMIT=
EVIDENCE_PACK_LIMIT=
STYLE_EXAMPLE_LIMIT=

# 동시성 · 비용
MODEL_CONCURRENCY_LIMIT=
ALERT_DISCORD_WEBHOOK_URL=
COST_ALERT_KRW_PER_DAY=

# 토큰 상한
MAX_TOTAL_PROMPT_TOKENS=
WRITER_MAX_PROMPT_TOKENS=
INTAKE_MAX_OUTPUT_TOKENS=
CONTEXT_MAX_OUTPUT_TOKENS=
BANTER_MAX_OUTPUT_TOKENS=
SENTENCING_MAX_OUTPUT_TOKENS=
WRITER_MAX_OUTPUT_TOKENS=
EVALUATOR_MAX_OUTPUT_TOKENS=

# 기능 플래그 (true | false)
ROOM_COMMENT_STYLE_ENABLED=
PUBLIC_HISTORY_CALLBACK_ENABLED=
REFLECT_ENABLED=
HINDSIGHT_ENABLED=
